---
// /thank-you — shown after a booking request is sent. Not indexed (and excluded from the sitemap).
// Personalised from sessionStorage "bp-booking-done" ({ firstName, occasion, service, ref }) when
// present; reads fine without JS. A ?ref=BP-… query (e.g. from a no-JS redirect) also shows the reference.
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getSettings, getOccasions, getServices, money, smsUrl, telUrl, mailUrl } from '../lib/site';
import { picnicPhrase } from '../components/occasion/text';
import hero from '../assets/photos/hero.jpg';

const s = await getSettings();
// "…planning your proposal picnic" for picnics and proposals; "…your room decor" / "…your custom hamper" otherwise.
const phrases = Object.fromEntries((await getOccasions()).map((o) => [o.id, picnicPhrase(o)]));
const phrasesJson = JSON.stringify(phrases).replace(/</g, '\\u003c');
const servicePhrases = Object.fromEntries((await getServices()).map((x) => [x.id, x.data.name.toLowerCase()]));
const noSecurityDeposit = (await getServices()).filter((x) => !x.data.securityDeposit).map((x) => x.id);
const servicesJson = JSON.stringify(servicePhrases).replace(/</g, '\\u003c');

const next: { title: string; text: string; security?: string; link?: { href: string; label: string } }[] = [
  {
    title: `We reply ${s.replyTime}`,
    text: 'By text or email, with availability for your date and your quote. If you don’t see it, check your spam folder or text us.',
  },
  {
    title: 'A booking deposit holds your date',
    text: `Once you’re happy with your quote, a ${money(s.deposit.standard)} booking deposit (or ${s.deposit.largeEventPercent}% for larger events) holds your date. It’s non-refundable.`,
    // only for services with rented decor (services.yaml securityDeposit); hidden by the script for the others
    security: `There’s also a ${money(s.securityDeposit.amount)} refundable security deposit, returned within ${s.securityDeposit.returnedWithin} after your event once all rental items are collected and checked.`,
    link: { href: '/policies', label: 'Read our booking policies' },
  },
  {
    title: 'We take care of the day',
    text: 'The balance is due before your event. Then we deliver — and for picnics and room decor, set up, style and clean up — so you can simply enjoy it.',
  },
];

// The hero photo only shows from 1024px, where it's above the fold (and the LCP). Every real source
// carries that media query and the <img> fallback is a 1×1 transparent GIF, so phones download nothing
// while desktops fetch it early, at high priority.
const DESKTOP = '(min-width: 1024px)';
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const heroWidths = [360, 540, 720, 960].filter((w) => w <= hero.width);
const heroSources = await Promise.all(
  (['avif', 'webp', 'jpg'] as const).map(async (format) => {
    const r = await getImage({ src: hero, widths: heroWidths.length ? heroWidths : [hero.width], format });
    return { type: format === 'jpg' ? 'image/jpeg' : `image/${format}`, srcset: r.srcSet.attribute };
  }),
);
---
<BaseLayout
  title="Thank You | Blush Picnic"
  description={`Your Blush Picnic booking request is on its way. We reply ${s.replyTime} by text or email with availability and your quote.`}
  noindex
  hideStickyBar
>
  <section class="container-x grid items-center gap-x-16 gap-y-12 pb-16 pt-10 md:pt-16 lg:grid-cols-12 lg:pb-24" aria-labelledby="thanks-title">
    <div class="hero-enter lg:col-span-7">
      <p class="ty-sent label-caps"><Icon name="check" size={16} />Request sent</p>
      <h1 id="thanks-title" class="mt-4 max-w-[14ch]"><span class="whitespace-nowrap">Thank you</span><span data-thanks-name></span>.</h1>
      <p class="mt-5 max-w-[36rem] text-lg text-plum-soft md:text-xl md:leading-relaxed">
        Your booking request is with us<span data-thanks-occasion hidden></span>. Here’s what happens next.
      </p>
      <p class="ty-ref" data-thanks-ref hidden>
        Your reference: <strong data-thanks-ref-value></strong>
      </p>

      <ol class="ty-steps mt-10">
        {next.map((step, i) => (
          <li>
            <span class="ty-num" aria-hidden="true">{i + 1}</span>
            <div>
              <h2 class="ty-step-title">{step.title}</h2>
              <p class="mt-1.5 text-plum-soft">{step.text}{step.security && <span data-security-deposit> {step.security}</span>}</p>
              {step.link && <a href={step.link.href} class="ty-link">{step.link.label}</a>}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="hero-enter-delay hidden lg:col-span-5 lg:block">
      <div class="arch-outline relative ml-auto mr-3 max-w-[26rem]">
        <picture>
          {heroSources.map((src) => <source media={DESKTOP} type={src.type} srcset={src.srcset} sizes="(min-width: 1280px) 416px, 34vw" />)}
          <img
            src={BLANK}
            alt={s.heroAlt}
            width={hero.width}
            height={hero.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="arch aspect-[4/5] h-full w-full bg-petal-deep object-cover"
          />
        </picture>
      </div>
    </div>
  </section>

  <section class="ty-band" aria-labelledby="ty-contact-title">
    <div class="container-x grid gap-12 py-14 md:grid-cols-2 md:gap-16 md:py-20">
      <div>
        <h2 id="ty-contact-title" class="text-[1.9rem] md:text-[2.3rem]">Questions in the meantime?</h2>
        <p class="mt-4 max-w-md text-plum-soft">Add a detail, change your date or ask anything — text is quickest.</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={smsUrl(s)} class="btn btn-primary" data-track="click_text"><Icon name="message" size={18} />Text {s.phoneDisplay}</a>
          <a href={telUrl(s)} class="btn btn-secondary" data-track="click_call"><Icon name="phone" size={18} />Call</a>
        </div>
        <p class="mt-5 text-[0.98rem] text-plum-soft">
          Or email <a href={mailUrl(s)} class="ty-link break-all">{s.email}</a>
        </p>
      </div>

      <div class="md:border-l md:border-line md:pl-16">
        <h2 class="text-[1.9rem] md:text-[2.3rem]">While you wait</h2>
        <p class="mt-4 max-w-md text-plum-soft">See recent setups and ideas on Instagram, or take another look at what we offer and what each package includes.</p>
        <ul class="mt-6 grid gap-1">
          <li>
            <a href={s.instagramUrl} rel="noopener" class="link-arrow" data-track="click_instagram">
              <Icon name="instagram" size={20} />Follow {s.instagramHandle}
            </a>
          </li>
          <li><a href="/gallery" class="link-arrow">Browse the gallery<Icon name="arrow-right" size={18} /></a></li>
          <li><a href="/services" class="link-arrow">Everything we set up<Icon name="arrow-right" size={18} /></a></li>
          <li><a href="/packages" class="link-arrow">Picnic packages &amp; prices<Icon name="arrow-right" size={18} /></a></li>
        </ul>
      </div>
    </div>
  </section>

  <span hidden data-thanks-phrases={phrasesJson} data-thanks-services={servicesJson} data-thanks-no-security={noSecurityDeposit.join(" ")}></span>
</BaseLayout>

<script>
  import { loadDone } from '../scripts/booking/storage';
  import { isPricedService } from '../scripts/booking/estimate';

  const done = loadDone();
  const refParam = new URLSearchParams(location.search).get('ref');
  const validRef = (r: unknown): r is string => typeof r === 'string' && /^BP-[A-Z0-9-]{3,24}$/i.test(r);

  const nameEl = document.querySelector<HTMLElement>('[data-thanks-name]');
  const first = done?.firstName?.trim().slice(0, 40);
  if (nameEl && first) nameEl.textContent = `, ${first}`;

  const occEl = document.querySelector<HTMLElement>('[data-thanks-occasion]');
  const dataEl = document.querySelector<HTMLElement>('[data-thanks-phrases]');
  const parse = (raw: string | undefined): Record<string, string> => {
    try {
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  };
  const phrases = parse(dataEl?.dataset.thanksPhrases);
  const services = parse(dataEl?.dataset.thanksServices);
  // A picnic or proposal is named after its occasion ("proposal picnic"); any other service after itself.
  const phrase =
    done?.service && !isPricedService(done.service) ? services[done.service] : done?.occasion ? phrases[done.occasion] : undefined;
  // No security deposit for a hamper (nothing is rented): drop that sentence.
  const noSecurity = (dataEl?.dataset.thanksNoSecurity ?? '').split(/\s+/).filter(Boolean);
  if (done?.service && noSecurity.includes(done.service)) document.querySelectorAll<HTMLElement>('[data-security-deposit]').forEach((el) => (el.hidden = true));
  if (occEl && phrase) {
    occEl.textContent = ` — we can’t wait to start planning your ${phrase}`;
    occEl.hidden = false;
  }

  const doneRef = done?.ref;
  const ref = validRef(doneRef) ? doneRef : validRef(refParam) ? refParam : undefined;
  const refBox = document.querySelector<HTMLElement>('[data-thanks-ref]');
  const refVal = document.querySelector<HTMLElement>('[data-thanks-ref-value]');
  if (ref && refBox && refVal) {
    refVal.textContent = ref.toUpperCase();
    refBox.hidden = false;
  }
</script>

<style>
  /* Brand label (rose spaced small caps, like the logo's tagline) above the title */
  .ty-sent {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ty-ref {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-cream);
    font-size: 1rem;
    color: var(--color-plum-soft);
  }
  .ty-ref strong { font-weight: 600; letter-spacing: 0.04em; color: var(--color-plum); white-space: nowrap; }
  .ty-steps { display: grid; gap: 1.75rem; max-width: 38rem; }
  .ty-steps li { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 1rem; }
  .ty-num { font-family: var(--font-display); font-size: 2.5rem; font-weight: 500; line-height: 0.9; font-variant-numeric: lining-nums; color: var(--color-rose); }
  .ty-step-title { font-size: clamp(1.45rem, 1.3rem + 0.5vw, 1.7rem); font-weight: 600; line-height: 1.2; }
  .ty-band { background: var(--color-cream); border-top: 1px solid var(--color-line); }
  .ty-link {
    font-weight: 600;
    color: var(--color-plum);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    display: inline-block;
    padding-block: 0.6rem;
  }
</style>

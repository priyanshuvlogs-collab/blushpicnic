---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeOccasions from '../components/home/HomeOccasions.astro';
import HomePackages from '../components/home/HomePackages.astro';
import HomeHow from '../components/home/HomeHow.astro';
import HomeGallery from '../components/home/HomeGallery.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import hero from '../assets/photos/hero.jpg';
import { getSettings, getPackages, money } from '../lib/site';
import { localBusiness, website } from '../lib/schema';

const s = await getSettings();
const pkgs = await getPackages();
const lowest = Math.min(...pkgs.map((p) => p.data.priceFrom));

const title = 'Luxury Picnics in Toronto & the GTA | Blush Picnic';
const description = `Luxury picnic setups in Toronto and the GTA for proposals, birthdays and dates. We deliver, set up, style and clean up. Starting at ${money(lowest)}, ${s.taxNote}.`;

const heroImg = await getImage({ src: hero, width: 1200, format: 'jpg' });
const jsonLd = [localBusiness(s, { image: new URL(heroImg.src, s.url).href }), website(s)];
---
<BaseLayout {title} {description} {jsonLd}>
  <HomeHero />
  <HomeOccasions />
  <HomePackages />
  <HomeHow />
  <HomeGallery />
  <ReviewsSection />
  <HomeFaq />
  <CtaBand />
</BaseLayout>

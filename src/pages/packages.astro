---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import PriceMenu from '../components/packages/PriceMenu.astro';
import PackageDetail from '../components/packages/PackageDetail.astro';
import CompareTable from '../components/packages/CompareTable.astro';
import AddOns from '../components/packages/AddOns.astro';
import DepositInfo from '../components/packages/DepositInfo.astro';
import PricingFaq from '../components/packages/PricingFaq.astro';
import { getSettings, getPackages, money, bookUrl } from '../lib/site';
import { NOT_SURE_PACKAGE } from '../lib/form';
import { service, breadcrumbs } from '../lib/schema';

const s = await getSettings();
const pkgs = await getPackages();
const entry = pkgs.reduce((a, b) => (b.data.priceFrom < a.data.priceFrom ? b : a));
const featured = pkgs.find((p) => p.data.featured) ?? pkgs[0];
const crumbs = [{ name: 'Packages', path: '/packages' }];

const title = 'Luxury Picnic Packages & Prices in Toronto | Blush Picnic';
const description = `Compare luxury picnic packages in Toronto & the GTA, starting at ${money(entry.data.priceFrom)} ${entry.data.guestsLabel}, ${s.taxNote}. Guests, time and what’s included, all spelled out.`;

// Stand-in photos (alt text starts "Placeholder") stay out of share cards and structured data:
// the page falls back to /og.jpg and the Service entries carry no image until real photos land.
const isPlaceholder = (alt: string) => /^placeholder\b/i.test(alt.trim());
const share = isPlaceholder(featured.data.imageAlt) ? {} : { image: featured.data.image, imageAlt: featured.data.imageAlt };

const jsonLd = [
  ...(await Promise.all(
    pkgs.map(async (p) => {
      if (isPlaceholder(p.data.imageAlt)) return service(s, p);
      const img = await getImage({ src: p.data.image, width: 1200, format: 'jpg' });
      return service(s, p, { image: new URL(img.src, s.url).href });
    }),
  )),
  breadcrumbs(s, crumbs),
];

const jump = [
  { href: '#compare', label: 'Compare packages' },
  { href: '#add-ons', label: 'Add-ons' },
  { href: '#deposit', label: 'Deposit & payment' },
  { href: '#pricing-questions', label: 'Pricing questions' },
];
---
<BaseLayout {title} {description} {jsonLd} {...share}>
  <section aria-labelledby="page-title" class="container-x pb-4 pt-3 md:pt-5">
    <Breadcrumbs crumbs={crumbs} />
    <div class="mt-5 grid items-center gap-x-14 gap-y-10 md:mt-8 lg:grid-cols-12">
      <div class="hero-enter lg:col-span-7 lg:row-start-1 lg:self-end">
        <h1 id="page-title" class="max-w-[17ch] text-wrap">Luxury picnic packages &amp;&nbsp;prices in&nbsp;Toronto</h1>
        <p class="measure mt-6 text-lg text-plum-soft md:text-xl md:leading-relaxed">
          Three starting points, with the guests, time and details spelled out. Every price is a starting price, {s.taxNote} — and every package is delivered, set up, styled and cleared away by us, anywhere in {s.serviceArea}.
        </p>
      </div>
      <PriceMenu class="hero-enter-delay mx-auto w-full max-w-[27rem] lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:mr-0" />
      <div class="lg:col-span-7 lg:row-start-2 lg:self-start">
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/book" class="btn btn-primary btn-lg" data-track="booking_cta" data-track-location="packages_hero">Book your picnic</a>
          <a href={bookUrl({ package: NOT_SURE_PACKAGE.id })} class="btn btn-secondary btn-lg" data-track="package_select" data-track-package={NOT_SURE_PACKAGE.id}>{NOT_SURE_PACKAGE.name}</a>
        </div>
        <nav aria-label="On this page" class="mt-6">
          <ul class="flex flex-wrap gap-x-6">
            {jump.map((j) => (
              <li><a href={j.href} class="inline-flex min-h-11 items-center gap-1.5 text-[0.95rem] font-medium underline decoration-line decoration-2 underline-offset-4 hover:decoration-gold">{j.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </section>

  {pkgs.map((p, i) => (
    <PackageDetail pkg={p} reverse={i % 2 === 1} tone={i % 2 === 1 ? 'cream' : 'petal'} />
  ))}

  <CompareTable />
  <AddOns />
  <DepositInfo />
  <PricingFaq />
  <CtaBand title="Found your package?" text={`Send a booking request and we’ll reply ${s.replyTime} with availability and your exact quote.`} />
</BaseLayout>

---
// /about — the owner's story (src/content/pages/about.md, currently a placeholder), what we do,
// what clients can count on, and where we set up. Facts come from settings.yaml.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArchImage from '../components/ArchImage.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Prose from '../components/pages/Prose.astro';
import { fillTokensText } from '../components/pages/prose';
import { getSettings, getPackages } from '../lib/site';
import { breadcrumbs, businessRef } from '../lib/schema';
import { versioned } from '../lib/brand';
import aboutPhoto from '../assets/photos/about.jpg';

const s = await getSettings();
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('src/content/pages/about.md is missing');
const d = entry.data;
const html = entry.rendered?.html ?? '';
const pkgs = await getPackages();
// The entry package lists the basics every picnic starts from ("Low picnic table", "Rugs and
// cushions", …); the others only list what they add. Used to describe what arrives with us.
const simple = pkgs.find((p) => p.id === 'simple') ?? pkgs.reduce((a, b) => (b.data.priceFrom < a.data.priceFrom ? b : a));
const kit = simple.data.includes.slice(0, 4).map((x) => x.toLowerCase()).join(', ');

const verbs = [
  { word: 'Deliver', text: `Everything arrives with us — ${kit} and more.` },
  { word: 'Set up', text: 'We get there ahead of you and build the picnic in the spot you chose.' },
  { word: 'Style', text: 'Your colours, your occasion, your words on the letter board. The details are the point.' },
  { word: 'Clean up', text: 'When your time is up, we come back and pack away all the decor and equipment.' },
];

const commitments = [
  {
    title: 'Styled around the person it’s for',
    text: 'We ask about the colours and the feeling you have in mind, and the words for your letter board, then style the setup around the answers — not around a template.',
  },
  {
    title: 'You arrive. We handle the rest.',
    text: 'Nothing to carry, nothing to set up, no decor to pack away. Your only job is to show up, with the ring, the cake or the people you love.',
  },
  {
    title: `Clear starting prices, ${s.taxNote}`,
    text: `Every package shows its starting price, guests and time. ${s.locationNote}`,
  },
  {
    title: `A reply ${s.replyTime}`,
    text: 'Send a booking request and we come back with availability for your date and your quote.',
  },
  {
    title: 'Your photos, your choice',
    text: 'We only share photos of your picnic on Instagram if you say yes — and “setup only, no faces” is an option in the booking form.',
  },
];

const crumbs = [{ name: 'About', path: '/about' }];
const jsonLd = [
  breadcrumbs(s, crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: d.metaTitle,
    url: `${s.url}/about`,
    description: d.metaDescription,
    about: businessRef(s),
  },
];
const metaDescription = await fillTokensText(d.metaDescription);
const lede = d.lede ? await fillTokensText(d.lede) : undefined;
---
<BaseLayout title={d.metaTitle} description={metaDescription} {jsonLd}>
  <section aria-labelledby="page-title">
    <div class="container-x pt-3 md:pt-5">
      <Breadcrumbs crumbs={crumbs} />
    </div>
    <div class="container-x grid items-center gap-x-14 gap-y-12 pb-16 pt-4 md:pb-20 md:pt-6 lg:grid-cols-12 lg:pb-24">
      <div class="hero-enter lg:col-span-7">
        <h1 id="page-title" class="max-w-[15ch]">{d.title}</h1>
        {lede && <p class="mt-6 max-w-[38rem] text-lg text-plum-soft md:mt-8 md:text-[1.25rem] md:leading-relaxed">{lede}</p>}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6 md:mt-10">
          <a href="/book" class="btn btn-primary btn-lg" data-track="booking_cta" data-track-location="about_hero">Book your picnic</a>
          <a href="#story" class="link-arrow self-start sm:self-auto">Read our story<Icon name="arrow-right" size={18} class="rotate-90" /></a>
        </div>
      </div>
      <div class="hero-enter-delay lg:col-span-5">
        <ArchImage
          src={aboutPhoto}
          alt="Placeholder photo — a portrait of the Blush Picnic owner will go here"
          sizes="(min-width: 1280px) 420px, (min-width: 1024px) 34vw, (min-width: 640px) 24rem, 78vw"
          priority
          outline
          class="mx-auto w-[78%] max-w-[24rem] sm:w-full lg:ml-auto lg:mr-3 lg:max-w-[26rem]"
        />
      </div>
    </div>
  </section>

  <section id="story" aria-labelledby="story-title" class="scroll-mt-20 pb-16 md:pb-24">
    <div class="container-x grid gap-5 md:gap-6 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        {/* The brand's badge (Logo Guide: "stickers, seals") signs the story, like a seal on a letter.
            Below 1024px its lettering would be smaller than the guide allows, so the basket mark
            (the guide's small-space logo) stands in. Decorative — the page already names the business. */}
        <div class="flex items-center justify-between gap-6 lg:sticky lg:top-28 lg:block">
          <h2 id="story-title">Our story</h2>
          <picture class="block shrink-0">
            <source media="(min-width: 1024px)" srcset={versioned('/brand/logo-badge.svg')} width="144" height="144" />
            <img
              src={versioned('/brand/logo-mark.svg')}
              alt=""
              width="104"
              height="81"
              loading="lazy"
              decoding="async"
              class="story-badge"
            />
          </picture>
        </div>
      </div>
      <div class="lg:col-span-8">
        <Prose {html} />
        <a href={s.instagramUrl} rel="noopener" class="link-arrow mt-6" data-track="click_instagram" data-track-location="about_story">
          <Icon name="instagram" size={20} />Follow along on Instagram {s.instagramHandle}
        </a>
      </div>
    </div>
  </section>

  <section aria-labelledby="what-title" class="section-y border-y border-line bg-cream">
    <div class="container-x">
      <div class="grid gap-5 lg:grid-cols-12 lg:items-end lg:gap-10">
        <h2 id="what-title" class="lg:col-span-5">What we do</h2>
        <p class="measure text-plum-soft lg:col-span-7 lg:pb-1">
          A styled picnic, without the logistics. In a park, on a beach, in your backyard, at home or in an indoor venue — anywhere in {s.serviceArea}. The same care goes into our <a href="/services" class="about-link">proposals, room decor and hampers</a>.
        </p>
      </div>
      <ol class="mt-12 grid gap-y-8 sm:grid-cols-2 sm:gap-x-10 md:mt-16 lg:grid-cols-4 lg:gap-x-0">
        {verbs.map((v) => (
          <li class="verb border-t border-line pt-6 lg:border-l lg:border-t-0 lg:px-8 lg:pt-1 lg:first:border-l-0 lg:first:pl-0">
            <h3 class="font-display text-[2rem] leading-none md:text-[2.4rem]">{v.word}</h3>
            <p class="mt-3 text-plum-soft">{v.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="count-title" class="section-y">
    <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <h2 id="count-title" class="lg:sticky lg:top-28">What you can count on</h2>
      </div>
      <ul class="divide-y divide-line border-y border-line lg:col-span-8">
        {commitments.map((c) => (
          <li class="grid gap-2 py-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10 md:py-8">
            <h3 class="text-[1.4rem] md:text-[1.55rem]">{c.title}</h3>
            <p class="text-plum-soft">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="where-title" class="pb-4">
    <div class="container-x">
      <div class="where rounded-[var(--radius-card)] bg-sage-wash px-6 py-12 sm:px-10 md:px-14 md:py-16">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-5">
            <h2 id="where-title">Where we set up</h2>
            <p class="mt-4 text-plum-soft">Parks, beaches, backyards, homes and indoor venues, anywhere in {s.serviceArea}.</p>
            <p class="mt-4 text-plum-soft">{s.locationNote}</p>
            <a href="/book" class="link-arrow mt-4" data-track="booking_cta" data-track-location="about_where">
              Need a spot? We'll suggest one<Icon name="arrow-right" size={18} />
            </a>
          </div>
          <div class="lg:col-span-7">
            <h3 class="label-caps text-sage-ink">Areas we serve</h3>
            {/* Jost on phones (Cormorant is too delicate at this size); the display face from md up. */}
            <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 sm:grid-cols-3 sm:gap-x-6 md:gap-y-2">
              {s.serviceAreaList.map((city) => (
                <li class="area flex items-center gap-2">
                  <Icon name="map-pin" size={16} class="shrink-0 text-sage-ink" /><span class="min-w-0">{city}</span>
                </li>
              ))}
            </ul>
            <p class="mt-5 text-plum-soft">…and across the GTA.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Let’s plan yours" text={`Tell us the occasion, the date and the area. We reply ${s.replyTime} with availability and your quote.`} />
</BaseLayout>

<style>
  .about-link {
    font-weight: 600;
    color: var(--color-cocoa);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .about-link:hover { text-decoration-color: var(--color-cocoa); }

  .story-badge {
    width: 5.5rem;
    height: auto;
  }
  @media (min-width: 640px) { .story-badge { width: 6.5rem; } }
  @media (min-width: 1024px) { .story-badge { width: 9rem; margin-top: 2.5rem; } }

  .area {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
  }
  @media (min-width: 768px) {
    .area {
      font-family: var(--font-display);
      font-size: 1.4rem;
      line-height: 1.3;
      font-variant-numeric: lining-nums;
    }
  }
</style>

---
// /policies — booking policies from src/content/pages/policies.md.
// Section ids are explicit in the markdown (<h2 id="weather">) because FAQ answers link to them;
// the build fails if one goes missing. The summary panel reads deposit facts from settings.yaml.
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Prose from '../components/pages/Prose.astro';
import PageToc from '../components/pages/PageToc.astro';
import ContactStrip from '../components/pages/ContactStrip.astro';
import { fillTokensText, h2Sections } from '../components/pages/prose';
import { getSettings, money } from '../lib/site';
import { breadcrumbs } from '../lib/schema';

/** Linked from FAQ answers and other pages — must always exist. */
const REQUIRED_IDS = ['deposit', 'payment', 'pricing', 'cancellation', 'weather', 'damage', 'permits', 'alcohol'];

const s = await getSettings();
const entry = await getEntry('pages', 'policies');
if (!entry) throw new Error('src/content/pages/policies.md is missing');
const d = entry.data;
const html = entry.rendered?.html ?? '';

const sections = h2Sections(html);
const missing = REQUIRED_IDS.filter((id) => !sections.some((x) => x.id === id));
if (missing.length) {
  throw new Error(`policies.md: missing section id(s) ${missing.join(', ')}. Keep <h2 id="…"> headings as they are.`);
}

const summary = [
  {
    href: '#deposit',
    label: 'Booking deposit',
    value: `${money(s.deposit.standard)} holds your date`,
    note: `or ${s.deposit.largeEventPercent}% for larger events · non-refundable`,
  },
  {
    href: '#deposit',
    label: 'Security deposit',
    value: `${money(s.securityDeposit.amount)}, refundable`,
    note: `returned within ${s.securityDeposit.returnedWithin} after your event`,
  },
  { href: '#payment', label: 'Payment', value: 'In full before your event', note: 'we start setting up once paid' },
  { href: '#weather', label: 'Weather', value: 'Unsafe weather? We reschedule', note: 'your booking deposit carries over' },
  { href: '#pricing', label: 'Prices', value: `Starting prices, ${s.taxNote}`, note: 'location affects your quote' },
];

const crumbs = [{ name: 'Policies', path: '/policies' }];
const jsonLd = [breadcrumbs(s, crumbs)];
const metaDescription = await fillTokensText(d.metaDescription);
const lede = d.lede ? await fillTokensText(d.lede) : undefined;
---
<BaseLayout title={d.metaTitle} description={metaDescription} {jsonLd}>
  <section aria-labelledby="page-title" class="container-x pt-3 md:pt-5">
    <Breadcrumbs crumbs={crumbs} />
    <div class="mt-6 grid gap-x-16 gap-y-10 pb-14 md:mt-10 md:pb-20 lg:grid-cols-12 lg:items-center">
      <div class="hero-enter lg:col-span-6">
        <h1 id="page-title" class="max-w-[12ch]">{d.title}</h1>
        {lede && <p class="mt-6 max-w-[34rem] text-lg text-plum-soft md:text-[1.25rem] md:leading-relaxed">{lede}</p>}
      </div>

      <div class="hero-enter-delay lg:col-span-6">
        <div class="policy-summary rounded-[var(--radius-card)] bg-cream px-6 py-6 sm:px-8 sm:py-7">
          <h2 class="heading-sm text-plum-soft">The short version</h2>
          <dl class="mt-3 divide-y divide-line">
            {summary.map((row) => (
              <div class="grid gap-0.5 py-3 sm:grid-cols-[8.5rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-4">
                <dt class="text-[0.95rem] text-plum-soft">{row.label}</dt>
                <dd>
                  <a href={row.href} class="summary-link">
                    <span class="font-display text-[1.3rem] leading-snug md:text-[1.45rem]">{row.value}</span>
                    {row.note && <span class="mt-0.5 block text-[0.95rem] text-plum-soft">{row.note}</span>}
                  </a>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-line">
    <div class="container-x grid gap-x-16 gap-y-10 py-12 md:py-16 lg:grid-cols-12 lg:py-20">
      <aside class="lg:col-span-3">
        <PageToc items={sections} class="lg:sticky lg:top-28" />
      </aside>
      <div class="lg:col-span-8 lg:col-start-5">
        <Prose {html} ruled />
      </div>
    </div>
  </div>

  <ContactStrip
    title="Questions about a policy?"
    text={`Text us before you book — we reply ${s.replyTime}. We'd rather explain now than surprise you later.`}
  />

  <CtaBand title="Ready when you are" />
</BaseLayout>

<style>
  .summary-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 2.75rem;
    text-decoration: none;
    border-radius: 8px;
  }
  .summary-link:hover .font-display {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
</style>

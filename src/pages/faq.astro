---
// /faq — every question in src/content/faqs.yaml, grouped by category, with an "at a glance"
// panel of starting prices (from packages.yaml) and deposit (from settings.yaml).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import PageToc from '../components/pages/PageToc.astro';
import ContactStrip from '../components/pages/ContactStrip.astro';
import { getSettings, getFaqs, getPackages, money, hours, type Faq } from '../lib/site';
import { breadcrumbs, faqPage } from '../lib/schema';

const s = await getSettings();
const faqs = await getFaqs();
const pkgs = await getPackages();

type Category = Faq['data']['category'];
const CATEGORIES: { id: Category; title: string; more?: { href: string; label: string } }[] = [
  { id: 'booking', title: 'Booking', more: { href: '/book', label: 'Start your booking request' } },
  { id: 'pricing', title: 'Pricing', more: { href: '/packages', label: 'Compare packages & prices' } },
  { id: 'the-day', title: 'On the day', more: { href: '/packages#compare', label: 'See what each package includes' } },
  { id: 'locations', title: 'Locations' },
  { id: 'policies', title: 'Policies', more: { href: '/policies', label: 'Read all booking policies' } },
];
const groups = CATEGORIES.map((c) => ({
  ...c,
  items: faqs.filter((f) => f.data.category === c.id).map((f) => ({ q: f.data.question, a: f.data.answer })),
})).filter((g) => g.items.length > 0);

const crumbs = [{ name: 'FAQ', path: '/faq' }];
const title = 'Picnic FAQs | Booking, Prices & Policies | Blush Picnic';
const description = `Answers about booking a luxury picnic in ${s.serviceArea}: the deposit, prices ${s.taxNote}, what’s included, food, locations, weather and policies.`;
const jsonLd = [faqPage(groups.flatMap((g) => g.items)), breadcrumbs(s, crumbs)];
---
<BaseLayout {title} {description} {jsonLd}>
  <section aria-labelledby="page-title" class="container-x pt-3 md:pt-5">
    <Breadcrumbs crumbs={crumbs} />
    <div class="mt-6 grid gap-x-16 gap-y-10 pb-12 md:mt-10 md:pb-16 lg:grid-cols-12 lg:items-center">
      <div class="hero-enter lg:col-span-6">
        <h1 id="page-title" class="max-w-[11ch]">Picnic questions, answered</h1>
        <p class="mt-6 max-w-[34rem] text-lg text-plum-soft md:text-[1.2rem] md:leading-relaxed">
          Booking, prices, the day itself, where we set up and our policies. Can't find yours? Text us — we reply {s.replyTime}.
        </p>
      </div>

      <div class="hero-enter-delay lg:col-span-6">
        <div class="rounded-[var(--radius-card)] bg-cream px-6 py-6 sm:px-8 sm:py-7">
          <h2 class="label-caps">At a glance</h2>
          <ul class="mt-2 divide-y divide-line">
            {pkgs.map((p) => (
              <li class="glance-row">
                <span>
                  <span class="block font-semibold">{p.data.name}</span>
                  <span class="block text-[0.95rem] text-plum-soft">{p.data.guestsLabel.replace(/^for\s+/i, '')} · {hours(p.data.durationHours)}</span>
                </span>
                <span class="text-right">
                  <span class="block text-[0.85rem] leading-tight text-plum-soft">Starting at</span>
                  <span class="glance-price block font-display">{money(p.data.priceFrom)}</span>
                </span>
              </li>
            ))}
            {/* Deposit notes run the full width under the name and amount, so they don't squeeze into a narrow column on phones. */}
            <li class="glance-row glance-row--note">
              <span class="font-semibold">Booking deposit</span>
              <span class="glance-price text-right font-display">{money(s.deposit.standard)}</span>
              <span class="glance-note">Holds your date, or {s.deposit.largeEventPercent}% for larger events · <span class="whitespace-nowrap">non-refundable</span></span>
            </li>
            <li class="glance-row glance-row--note">
              <span class="font-semibold">Security deposit</span>
              <span class="glance-price text-right font-display">{money(s.securityDeposit.amount)}</span>
              <span class="glance-note">Refundable, returned within {s.securityDeposit.returnedWithin} once items are collected and checked</span>
            </li>
          </ul>
          <p class="mt-3 text-[0.92rem] leading-relaxed text-plum-soft">
            All starting prices, {s.taxNote}. {s.locationNote}
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="border-t border-line">
    <div class="container-x grid gap-x-16 gap-y-10 py-12 md:py-16 lg:grid-cols-12 lg:py-20">
      <aside class="lg:col-span-3">
        <PageToc items={groups.map((g) => ({ id: g.id, label: g.title }))} label="Jump to" class="lg:sticky lg:top-28" />
      </aside>

      <div class="grid gap-14 md:gap-20 lg:col-span-8 lg:col-start-5">
        {groups.map((g) => (
          <section id={g.id} aria-labelledby={`${g.id}-title`} class="scroll-mt-24">
            <h2 id={`${g.id}-title`} class="text-[1.9rem] md:text-[2.4rem]">{g.title}</h2>
            <FaqList items={g.items} headingLevel="h3" class="mt-5 md:mt-7" />
            {g.more && (
              <a href={g.more.href} class="link-arrow mt-3">
                {g.more.label}<Icon name="arrow-right" size={18} />
              </a>
            )}
          </section>
        ))}
      </div>
    </div>
  </div>

  <ContactStrip location="faq" />

  <CtaBand />
</BaseLayout>

<style>
  .glance-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem;
    padding-block: 0.8rem;
  }
  .glance-row--note { align-items: baseline; row-gap: 0.15rem; }
  .glance-price {
    font-size: 1.6rem;
    line-height: 1;
    font-weight: 500;
  }
  .glance-note {
    grid-column: 1 / -1;
    font-size: 0.95rem;
    color: var(--color-plum-soft);
  }
</style>

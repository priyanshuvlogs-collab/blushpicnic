---
// /services — the five things Blush Picnic sets up (services.yaml), as an editorial contents page:
// picnics lead with the page's one arched photo, the other four follow as alternating rows.
// A service with dm: true is booked by Instagram DM, with the form as the second route.
import { getImage, Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArchImage from '../components/ArchImage.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { startingLine } from '../components/occasion/text';
import { photoKind } from '../components/photoNote';
import { getSettings, getServices, getPackages, bookUrl, igDmUrl, type Service } from '../lib/site';
import { breadcrumbs, genericService } from '../lib/schema';

const s = await getSettings();
const services = await getServices();
const pkgs = await getPackages();
const lowest = pkgs.reduce((a, b) => (b.data.priceFrom < a.data.priceFrom ? b : a));
const [lead, ...rest] = services;
const pad = (n: number) => String(n).padStart(2, '0');
const kind = (x: Service) => photoKind(x.data.image, x.data.imageAlt);
// Stand-in and AI pictures are explained once, under the list; neither goes into structured data.
const standIns = services.filter((x) => kind(x) === 'placeholder').map((x) => x.data.name.toLowerCase());
const aiCount = services.filter((x) => kind(x) === 'ai').length;
const list = (names: string[]) => (names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : (names[0] ?? ''));

const crumbs = [{ name: 'Services', path: '/services' }];
const title = 'Picnics, Proposals, Room Decor & Hampers, Toronto | Blush Picnic';
const description = `Styled picnics, proposal setups, room decor, birthday hamper delivery and custom hampers across ${s.serviceArea}, delivered, set up and styled by us.`;

const jsonLd = [
  breadcrumbs(s, crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Blush Picnic services',
    numberOfItems: services.length,
    itemListElement: await Promise.all(
      services.map(async (x, i) => {
        const image = kind(x) === 'real' ? new URL((await getImage({ src: x.data.image, width: 1200, format: 'jpg' })).src, s.url).href : undefined;
        const { '@context': _ctx, ...item } = genericService(s, { name: x.data.name, description: x.data.summary, url: `${s.url}${x.data.href}`, image });
        return { '@type': 'ListItem', position: i + 1, item };
      }),
    ),
  },
];
const widths = (x: Service, list: number[]) => list.filter((w) => w <= x.data.image.width);
---
<BaseLayout {title} {description} {jsonLd}>
  <section aria-labelledby="page-title" class="container-x pt-3 md:pt-5">
    <Breadcrumbs crumbs={crumbs} />
    <div class="hero-enter mt-5 grid gap-x-14 gap-y-6 pb-10 md:mt-8 md:pb-14 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <h1 id="page-title" class="max-w-[14ch]">Picnics, proposals, room decor and hampers</h1>
        <p class="mt-6 max-w-[36rem] text-lg text-plum-soft md:text-[1.25rem] md:leading-relaxed">
          Five things we set up across {s.serviceArea}, every one delivered, set up and styled by us. Tell us the date and the idea, and we reply {s.replyTime} with your quote.
        </p>
      </div>
      <nav aria-label="On this page" class="lg:col-span-5 lg:pb-2">
        <ul class="flex flex-wrap gap-2">
          {services.map((x) => (
            <li>
              <a href={`#${x.id}`} class="inline-flex min-h-11 items-center rounded-full border border-cocoa/25 bg-cream/60 px-4 text-[0.95rem] font-medium no-underline transition-colors hover:border-cocoa hover:bg-cream">{x.data.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  {lead && (
    <section id={lead.id} aria-labelledby={`${lead.id}-title`} class="scroll-mt-20 border-t border-line bg-cream">
      <div class="container-x grid items-center gap-x-14 gap-y-10 py-14 md:py-20 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <ArchImage
            src={lead.data.image}
            alt={lead.data.imageAlt}
            sizes="(min-width: 1280px) 420px, (min-width: 1024px) 34vw, (min-width: 640px) 24rem, 78vw"
            priority
            fetchpriority="auto"
            outline
            class="mx-auto w-[78%] max-w-[24rem] sm:w-full lg:mr-auto lg:ml-3 lg:max-w-[26rem]"
          />
        </div>
        <div class="lg:col-span-7 lg:pl-4">
          <p class="font-display text-[1.6rem] leading-none text-gold-ink" aria-hidden="true">{pad(1)}</p>
          <h2 id={`${lead.id}-title`} class="mt-3">{lead.data.name}</h2>
          <p class="mt-2 text-lg text-plum-soft md:text-xl">{lead.data.short}</p>
          <p class="measure mt-6">{lead.data.summary}</p>
          <p class="mt-5 flex items-start gap-2.5 text-plum-soft">
            <Icon name="sparkle" size={20} class="mt-[0.2em] shrink-0 text-sage-ink" />
            <span>{startingLine(lowest, s)}. {s.locationNote}</span>
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
            <a href={lead.data.href} class="btn btn-primary btn-lg">{lead.data.cta}</a>
            <a href={bookUrl({ service: lead.id })} class="link-arrow" data-track="booking_cta" data-track-location="services_picnics">Book a picnic<Icon name="arrow-right" size={18} /></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <div class="container-x">
    <ol class="divide-y divide-line" role="list">
      {rest.map((x, i) => {
        const n = i + 2;
        const flip = i % 2 === 1;
        return (
          <li id={x.id} class="svc scroll-mt-20 py-12 md:py-16">
            <article aria-labelledby={`${x.id}-title`} class="grid items-center gap-x-12 gap-y-7 md:grid-cols-12">
              <div class:list={['md:col-span-4 lg:col-span-3', flip && 'md:order-2 md:col-start-9 lg:col-start-10']}>
                <Picture
                  src={x.data.image}
                  alt={x.data.imageAlt}
                  widths={widths(x, [240, 360, 480, 640, 800])}
                  sizes="(min-width: 1280px) 280px, (min-width: 768px) 30vw, 60vw"
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  loading="lazy"
                  class="aspect-[4/5] w-[60%] max-w-[18rem] rounded-[var(--radius-card)] bg-petal-deep object-cover sm:w-[50%] md:w-full"
                />
              </div>
              <div class:list={['md:col-span-8 lg:col-span-8', flip ? 'md:order-1 md:col-start-1 lg:col-start-1' : 'lg:col-start-5']}>
                <p class="font-display text-[1.4rem] leading-none text-gold-ink" aria-hidden="true">{pad(n)}</p>
                <h2 id={`${x.id}-title`} class="mt-3 text-[2rem] md:text-[2.5rem]">{x.data.name}</h2>
                <p class="mt-2 text-lg text-plum-soft">{x.data.short}</p>
                <p class="measure mt-5">{x.data.summary}</p>
                <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6">
                  {x.data.dm ? (
                    <>
                      <a href={igDmUrl(s)} rel="noopener" class="btn btn-primary" data-track="click_instagram" data-track-location={`services_${x.id}`}>
                        <Icon name="instagram" size={18} />{x.data.cta}
                      </a>
                      <a href={bookUrl({ service: x.id })} class="link-arrow" data-track="booking_cta" data-track-location={`services_${x.id}`}>or send a request<Icon name="arrow-right" size={18} /></a>
                    </>
                  ) : (
                    <>
                      <a href={x.data.href} class="btn btn-secondary">{x.data.cta}</a>
                      <a href={bookUrl({ service: x.id })} class="link-arrow" data-track="booking_cta" data-track-location={`services_${x.id}`}>Send a request<Icon name="arrow-right" size={18} /></a>
                    </>
                  )}
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ol>

    {(standIns.length > 0 || aiCount > 0) && (
      <div class="grid gap-3 border-t border-line pt-8">
        {standIns.length > 0 && (
          <p class="placeholder-note max-w-2xl">
            <strong>Placeholder —</strong> {list(standIns)} {standIns.length > 1 ? 'are' : 'is'} shown with a stand-in frame until photos are added.
          </p>
        )}
        {aiCount > 0 && (
          <p class="placeholder-note max-w-2xl">
            <strong>AI illustrations —</strong> {aiCount === services.length ? 'the' : 'some of the'} photos on this page were created with AI to show the style of each service. Photos from real Blush Picnic setups are coming soon.
          </p>
        )}
      </div>
    )}
  </div>

  <CtaBand title="Not sure which one you need?" text={`Tell us about the moment and the person it’s for. We reply ${s.replyTime} with ideas and your quote.`} buttonLabel="Send a request" />
</BaseLayout>

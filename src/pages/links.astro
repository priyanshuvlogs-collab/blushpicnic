---
// Instagram link-in-bio (/links). Not indexed. Big, thumb-sized buttons; every tap is tracked.
// Occasion links come from occasion data and are skipped if that page doesn't exist yet.
// It opens on the basket mark (public/brand/logo-mark.svg, the guide's "Basket mark") in a
// linen arch — the arch echoing the basket's handle — so visitors arriving from the profile
// recognise the brand at once. The mark is used as-is: never recoloured, stretched or cropped.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getSettings, getPackages, getOccasions, occasionUrl, smsUrl, telUrl, mailUrl, money, type Occasion } from '../lib/site';

type IconName = 'message' | 'phone' | 'mail';
interface LinkItem {
  href: string;
  label: string;
  sub: string;
  icon?: IconName;
  primary?: boolean;
  /** data-track event + params */
  event: string;
  params: Record<string, string>;
}

const s = await getSettings();
const pkgs = await getPackages();
const entry = pkgs.reduce((a, b) => (b.data.priceFrom < a.data.priceFrom ? b : a));
// Non-breaking space keeps "before HST" together at the end of a wrapped line.
const startingAt = (priceFrom: number, guestsLabel: string) => `starting at ${money(priceFrom)} ${guestsLabel}, ${s.taxNote.replace(/ /g, '\u00a0')}`;
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

const occasions = new Map((await getOccasions()).map((o) => [o.id, o]));
const occasionLink = (o: Occasion | undefined): LinkItem[] => {
  if (!o) return [];
  const pkg = pkgs.find((p) => p.id === o.data.recommendedPackage);
  return [
    {
      href: occasionUrl(o),
      label: `${o.data.name} picnics`,
      sub: pkg ? `${pkg.data.name}, ${startingAt(pkg.data.priceFrom, pkg.data.guestsLabel)}` : `Ideas and details for your ${o.data.name.toLowerCase()}`,
      event: 'link_click',
      params: { link: o.id },
    },
  ];
};

const plan: LinkItem[] = [
  { href: '/book', label: 'Book your picnic', sub: `We reply ${s.replyTime} with your quote`, primary: true, event: 'booking_cta', params: { location: 'links' } },
  { href: '/packages', label: 'Packages & prices', sub: cap(startingAt(entry.data.priceFrom, entry.data.guestsLabel)), event: 'link_click', params: { link: 'packages' } },
  ...occasionLink(occasions.get('proposal')),
  ...occasionLink(occasions.get('birthday')),
  { href: '/gallery', label: 'See the gallery', sub: 'Setups to inspire yours', event: 'link_click', params: { link: 'gallery' } },
];

const talk: LinkItem[] = [
  { href: smsUrl(s), label: 'Text us', sub: s.phoneDisplay, icon: 'message', event: 'click_text', params: { location: 'links' } },
  { href: telUrl(s), label: 'Call', sub: s.phoneDisplay, icon: 'phone', event: 'click_call', params: { location: 'links' } },
  { href: mailUrl(s), label: 'Email', sub: s.email, icon: 'mail', event: 'link_click', params: { link: 'email' } },
];

const trackAttrs = (l: LinkItem) => ({
  'data-track': l.event,
  ...Object.fromEntries(Object.entries(l.params).map(([k, v]) => [`data-track-${k}`, v])),
});
---
<BaseLayout
  title="Links | Blush Picnic — Luxury Picnics in Toronto"
  description={`Book a luxury picnic in ${s.serviceArea}, see packages and prices, or text, call or email ${s.name}. We deliver, set up, style and clean up.`}
  noindex
  hideStickyBar
>
  <section aria-labelledby="links-title" class="container-x pb-16 pt-6 md:pb-24 md:pt-10">
    <div class="hero-enter mx-auto max-w-[29rem]">
      <div class="text-center">
        <div class="arch-outline mx-auto mt-3 w-[9rem]">
          <div class="arch flex aspect-[4/5] items-end justify-center bg-cream pb-[1.4rem]">
            {/* viewBox 108.36 × 84.65; side clear space ≈ the width of the heart tag */}
            <img src="/brand/logo-mark.svg" alt="" width="104" height="81" loading="eager" decoding="async" class="w-[6.5rem]" />
          </div>
        </div>
        <h1 id="links-title" class="mx-auto mt-7 max-w-[18ch] text-[2.1rem] leading-[1.08] sm:text-[2.4rem]">{s.tagline}</h1>
        <p class="mx-auto mt-3 max-w-[22rem] text-plum-soft">
          We deliver, set up, style and clean up — you just arrive.
        </p>
      </div>

      <ul class="mt-8 grid gap-3">
        {plan.map((l) => (
          <li>
            <a href={l.href} class:list={['link-btn', l.primary && 'link-btn-primary']} {...trackAttrs(l)}>
              <span class="min-w-0">
                <span class="block text-[1.06rem] font-semibold leading-snug">{l.label}</span>
                <span class="link-sub mt-0.5 block text-[0.88rem] leading-snug">{l.sub}</span>
              </span>
              <Icon name="arrow-right" size={20} class="shrink-0" />
            </a>
          </li>
        ))}
      </ul>

      <h2 class="label-caps mt-11 text-center">Prefer to talk first?</h2>
      <ul class="mt-3 grid gap-3">
        {talk.map((l) => (
          <li>
            <a href={l.href} class="link-btn" {...trackAttrs(l)}>
              <span class="flex min-w-0 items-center gap-3.5">
                <span class="grid size-10 shrink-0 place-items-center rounded-full bg-petal text-rose">{l.icon && <Icon name={l.icon} size={20} />}</span>
                <span class="min-w-0">
                  <span class="block text-[1.06rem] font-semibold leading-snug">{l.label}</span>
                  <span class="link-sub mt-0.5 block text-[0.88rem] leading-snug [overflow-wrap:anywhere]">{l.sub.includes('@') ? <>{l.sub.slice(0, l.sub.indexOf('@') + 1)}<wbr />{l.sub.slice(l.sub.indexOf('@') + 1)}</> : l.sub}</span>
                </span>
              </span>
              <Icon name="arrow-right" size={20} class="shrink-0" />
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-6 flex items-center justify-center gap-8">
        <a href={s.instagramUrl} rel="noopener" class="link-arrow" data-track="click_instagram" data-track-location="links"><Icon name="instagram" size={20} />Instagram</a>
        <a href={s.tiktokUrl} rel="noopener" class="link-arrow" data-track="click_tiktok" data-track-location="links"><Icon name="tiktok" size={20} />TikTok</a>
      </div>

      <p class="mt-6 text-center text-[0.88rem] text-plum-soft">All prices are starting prices, {s.taxNote}. {s.locationNote}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .link-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-btn);
    border: 1px solid var(--color-line);
    background: var(--color-cream);
    color: var(--color-cocoa);
    text-decoration: none;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .link-btn:hover { border-color: var(--color-rose); }
  @media (prefers-reduced-motion: no-preference) {
    .link-btn { transition: border-color 0.2s, background-color 0.2s, transform 0.2s var(--ease-out-soft); }
    .link-btn:active { transform: translateY(1px); }
  }
  .link-sub { color: var(--color-plum-soft); }
  /* Rose, like every primary button; the subline stays full linen so it keeps AA contrast. */
  .link-btn-primary { background: var(--color-rose); border-color: var(--color-rose); color: var(--color-cream); min-height: 4.75rem; }
  .link-btn-primary:hover { background: var(--color-rose-hover); border-color: var(--color-rose-hover); }
  .link-btn-primary .link-sub { color: var(--color-cream); }
</style>

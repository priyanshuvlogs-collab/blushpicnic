---
// Travel fee by area (settings.yaml → travel). fee: number → "Starting at $X"; null → quoted by area.
// Every quote carries one, so it sits beside Deposit & payment on /packages.
import Icon from '../Icon.astro';
import { getSettings, money } from '../../lib/site';

const s = await getSettings();
const areas = s.travel.areas;
const fee = (f: number | null) => (f === null ? 'Quoted by area' : `Starting at ${money(f)}`);
const anyPriced = areas.some((a) => a.fee !== null);
---
<section id="travel" aria-labelledby="travel-title" class="section-y scroll-mt-20">
  <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <h2 id="travel-title">Travel by area</h2>
      <p class="mt-4 max-w-md text-plum-soft">{s.travel.note}</p>
      <p class="mt-3 flex max-w-md items-start gap-2.5 text-plum-soft">
        <Icon name="map-pin" size={20} class="mt-[0.2em] shrink-0 text-sage-ink" />
        <span>Somewhere else in the GTA? Name the area in your request and we'll quote the travel with it.</span>
      </p>
    </div>
    <div class="lg:col-span-7">
      <dl class="travel grid border-t border-line sm:grid-cols-2 sm:gap-x-10 sm:border-t-0">
        {areas.map((a) => (
          <div class="flex items-baseline gap-3 border-b border-line py-3 sm:border-t sm:border-b-0">
            <dt class="font-medium">{a.name}</dt>
            <span aria-hidden="true" class="mb-[0.3rem] h-0 min-w-4 flex-1 self-end border-b border-dotted border-cocoa/35"></span>
            <dd class="shrink-0 text-[0.95rem] text-plum-soft">{fee(a.fee)}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-5 text-[0.95rem] text-plum-soft">
        {anyPriced ? `Travel fees are starting prices, ${s.taxNote}. ` : ''}The travel fee is confirmed in your quote, {s.taxNote}.
      </p>
    </div>
  </div>
</section>

<style>
  /* Two columns from 640px, rows ruled on top. The last two rows are each column's final row (with an
     odd count, the right column ends one row earlier), so they close with a bottom rule. */
  @media (min-width: 640px) {
    .travel > div:nth-last-child(-n + 2) { border-bottom: 1px solid var(--color-line); }
  }
</style>

---
// One rich section per package on /packages. All copy and numbers come from packages.yaml;
// "A lovely fit for" links only to occasion pages that exist (unknown bestFor ids are skipped).
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import PriceTag from '../PriceTag.astro';
import { getOccasions, occasionUrl, bookUrl, money, hours, smsUrl, getSettings, type Package, type Occasion } from '../../lib/site';

interface Props {
  pkg: Package;
  /** photo on the right instead of the left (desktop) */
  reverse?: boolean;
  /** cream band behind the section, for rhythm */
  tone?: 'petal' | 'cream';
}
const { pkg, reverse = false, tone = 'petal' } = Astro.props;
const s = await getSettings();
const d = pkg.data;

const occasions = new Map((await getOccasions()).map((o) => [o.id, o]));
const bestFor = d.bestFor.map((id) => occasions.get(id)).filter((o): o is Occasion => Boolean(o));

// Skip a priceNote that only repeats the extra-guest price PriceTag already shows.
const showNote = d.priceNote && !(d.extraGuestPrice !== null && d.priceNote.includes(money(d.extraGuestPrice)));
const label = `Book the ${d.name}${/picnic$/i.test(d.name) ? '' : ' package'}`;
const headingId = `pkg-${pkg.id}-title`;
---
<section id={pkg.id} aria-labelledby={headingId} class:list={['section-y scroll-mt-20', tone === 'cream' && 'bg-cream']}>
  <div class="container-x grid items-start gap-x-14 gap-y-10 lg:grid-cols-12">
    <div class:list={['lg:sticky lg:top-28 lg:col-span-6', reverse && 'lg:order-2 lg:col-start-7']}>
      <Picture
        src={d.image}
        alt={d.imageAlt}
        width={960}
        height={1200}
        fit="cover"
        widths={[400, 640, 800, 960]}
        sizes="(min-width: 1280px) 560px, (min-width: 1024px) 45vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="lazy"
        class="aspect-[4/3] w-full rounded-[var(--radius-card)] bg-petal-deep object-cover lg:aspect-[4/5]"
      />
    </div>

    <div class:list={['lg:col-span-6', reverse ? 'lg:order-1 lg:pr-4' : 'lg:pl-4']}>
      <h2 id={headingId}>{d.name}</h2>
      <p class="mt-3 text-lg text-plum-soft md:text-xl">{d.tagline}</p>

      <div class="mt-7 flex flex-wrap items-end gap-x-10 gap-y-5 border-y border-line py-6">
        <PriceTag pkg={pkg} size="lg" showDuration={false} />
        <ul class="grid gap-1.5 text-[0.98rem]">
          <li class="flex items-center gap-2.5"><Icon name="clock" size={20} class="shrink-0 text-sage-ink" />{hours(d.durationHours)} of picnic time</li>
          <li class="flex items-center gap-2.5"><Icon name="map-pin" size={20} class="shrink-0 text-sage-ink" />Park, beach, backyard, home or venue</li>
          <li class="flex items-center gap-2.5"><Icon name="sparkle" size={20} class="shrink-0 text-sage-ink" />Delivery, setup, styling &amp; clean-up</li>
        </ul>
      </div>

      <p class="measure mt-6">{d.summary}</p>

      <h3 class="heading-sm mt-8 text-[1.0625rem]">What's included</h3>
      {d.includesFrom && <p class="mt-2 text-plum-soft">{d.includesFrom}</p>}
      <ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
        {d.includes.map((item) => (
          <li class="flex gap-2.5">
            <Icon name="check" size={20} class="mt-[0.2em] shrink-0 self-start text-sage-ink" />
            <span>{item}</span>
          </li>
        ))}
      </ul>

      {showNote && <p class="mt-5 text-[0.95rem] text-plum-soft">{d.priceNote}</p>}

      {bestFor.length > 0 && (
        <div class="mt-8">
          <h3 class="heading-sm text-[1.0625rem]">A lovely fit for</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {bestFor.map((o) => (
              <li>
                <a href={occasionUrl(o)} class="inline-flex min-h-11 items-center rounded-full border border-plum/25 px-4 text-[0.95rem] font-medium no-underline transition-colors hover:border-plum hover:bg-cream">{o.data.chip}</a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6">
        <a href={bookUrl({ package: pkg.id })} class="btn btn-primary btn-lg" data-track="package_select" data-track-package={pkg.id}>{label}</a>
        <a href={smsUrl(s)} class="link-arrow" data-track="click_text"><Icon name="message" size={18} />Text us a question</a>
      </div>
    </div>
  </div>
</section>

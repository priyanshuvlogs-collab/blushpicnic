---
// Home hero: what we do, where, and that the client does nothing. Primary CTA must sit in the
// first viewport on a 390×844 phone, so the text comes first on mobile and the arch follows.
import ArchImage from '../ArchImage.astro';
import Icon from '../Icon.astro';
import hero from '../../assets/photos/hero.jpg';
import { getSettings, getPackages, getOccasions, money, hours, smsUrl, telUrl } from '../../lib/site';

const s = await getSettings();
const pkgs = await getPackages();
// Price anchor = the lowest starting price, so it stays true if the packages change.
const entry = pkgs.reduce((a, b) => (b.data.priceFrom < a.data.priceFrom ? b : a));
const e = entry.data;

// The hero's one brand label (spaced small caps, like the logo tagline): three of the occasions
// we style, named from occasion data so it only lists pages that exist.
const occasions = new Map((await getOccasions()).map((o) => [o.id, o]));
// Joined as a phrase ("Proposals, Birthdays & Picnic dates") so it wraps gracefully on small phones.
const chips = ['proposal', 'birthday', 'picnic-date'].flatMap((id) => occasions.get(id)?.data.chip.replace(/ /g, '\u00a0') ?? []);
const kicker = chips.length > 1 ? `${chips.slice(0, -1).join(', ')} & ${chips.at(-1)}` : (chips[0] ?? '');
---
<section class="relative" aria-labelledby="hero-title">
  <div class="container-x grid items-center gap-x-10 gap-y-14 pb-16 pt-7 sm:pt-10 md:pb-20 lg:grid-cols-12 lg:pb-24 lg:pt-14">
    <div class="hero-enter lg:col-span-7">
      {kicker && <p class="label-caps mb-4 md:mb-5">{kicker}</p>}
      <h1 id="hero-title" class="max-w-[17ch]">Luxury picnics in Toronto, styled and waiting for you</h1>
      <p class="mt-5 max-w-[36rem] text-lg text-plum-soft md:mt-7 md:text-[1.25rem] md:leading-relaxed">
        We deliver, set up, style and clean up — in a park, on a beach, in your backyard or indoors, anywhere in {s.serviceArea}. You just arrive. Planning a proposal, room decor or a birthday hamper? We do those too.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:flex-row md:mt-9">
        <a href="/book" class="btn btn-primary btn-lg" data-track="booking_cta" data-track-location="hero">Book your picnic</a>
        <a href="/packages" class="btn btn-secondary btn-lg">See packages</a>
      </div>

      <p class="mt-6 max-w-[36rem] text-[0.95rem] leading-relaxed text-plum-soft">
        <span class="font-semibold text-cocoa">{e.name}</span>, <span class="whitespace-nowrap">starting at
        <span class="font-display text-[1.5rem] font-semibold leading-none text-cocoa">{money(e.priceFrom)}</span></span>
        <span class="whitespace-nowrap">{e.guestsLabel}</span> · <span class="whitespace-nowrap">{hours(e.durationHours)}</span> · <span class="whitespace-nowrap">{s.taxNote}</span> · <span class="whitespace-nowrap">plus travel by area</span>
      </p>

      <p class="mt-2 flex flex-wrap items-center gap-x-1.5 text-[0.95rem] text-plum-soft">
        <span>Questions first?</span>
        <span class="inline-flex items-center gap-x-1.5 whitespace-nowrap">
          <a href={smsUrl(s)} class="hero-contact" data-track="click_text"><Icon name="message" size={18} />Text</a>
          <span>or</span>
          <a href={telUrl(s)} class="hero-contact" data-track="click_call"><Icon name="phone" size={18} />call {s.phoneDisplay}</a>
        </span>
      </p>
    </div>

    <div class="hero-enter-delay lg:col-span-5">
      <ArchImage
        src={hero}
        alt={s.heroAlt}
        sizes="(min-width: 1280px) 440px, (min-width: 1024px) 36vw, (min-width: 640px) 26rem, 82vw"
        widths={[360, 540, 720, 960, 1280]}
        priority
        outline
        class="mx-auto w-[82%] max-w-[26rem] sm:w-full lg:ml-auto lg:mr-3 lg:max-w-[28rem]"
      />
    </div>
  </div>
</section>

<style>
  .hero-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-cocoa);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .hero-contact:hover { text-decoration-color: var(--color-cocoa); }
</style>

---
// The gallery: occasion filters + masonry grid + a contextual "book" link that follows the filter.
//
// • Photos and their occasions come from src/content/gallery.yaml (order = gallery order).
// • Filters list only occasions that have photos, in occasion order, with "All" first.
//   ?occasion=<id> pre-selects one (occasion pages link here that way); see src/scripts/gallery-filter.ts.
// • Each photo links to its large (~1600px) WebP, so it works without JavaScript; with JS it opens
//   the lightbox (src/scripts/lightbox.ts), which loads only the large image being viewed.
// • The occasion name under each photo links to that occasion's page (real links for every
//   occasion, with or without JavaScript).
import { Picture, getImage } from 'astro:assets';
import Icon from '../Icon.astro';
import { getGallery, getOccasions, bookUrl, occasionUrl, type Occasion } from '../../lib/site';
import { picnicPhrase, picnicPhrasePlural } from '../occasion/text';
import { columnStarts } from './columns';

const gallery = await getGallery();
const occasions = await getOccasions();
const byId = new Map(occasions.map((o) => [o.id, o]));

// An occasion id in gallery.yaml without a page yet still gets a readable label.
const fallbackName = (id: string) => id.charAt(0).toUpperCase() + id.slice(1).replace(/-/g, ' ');
const meta = (id: string) => {
  const o: Occasion | undefined = byId.get(id);
  return o
    ? { name: o.data.name, chip: o.data.chip, phrase: picnicPhrase(o), plural: picnicPhrasePlural(o), page: occasionUrl(o), order: o.data.order }
    : { name: fallbackName(id), chip: fallbackName(id), phrase: `${fallbackName(id).toLowerCase()} picnic`, plural: `${fallbackName(id).toLowerCase()} picnics`, page: '', order: 999 };
};

const used = [...new Set(gallery.flatMap((g) => g.data.occasions))];
const filters = used
  .map((id) => ({ id, ...meta(id), book: bookUrl({ occasion: id }) }))
  .sort((a, b) => a.order - b.order || a.name.localeCompare(b.name));

const LARGE = 1600;
const items = await Promise.all(
  gallery.map(async (g) => {
    const occ = g.data.occasions[0];
    const m = meta(occ);
    const w = Math.min(LARGE, g.data.image.width);
    const large = await getImage({ src: g.data.image, width: w, format: 'webp', quality: 82 });
    return {
      g,
      occ,
      m,
      large: { src: large.src, w, h: Math.round((w * g.data.image.height) / g.data.image.width) },
      book: bookUrl({ occasion: occ }),
    };
  }),
);
const anyPlaceholder = gallery.some((g) => g.data.placeholder);
const total = items.length;

// Only the first photo of each column is on screen when the page opens (CSS columns fill top to
// bottom), so those load eagerly and the rest lazily. columnStarts() re-runs the browser's column
// balancing from each photo's shape; the numbers mirror the CSS below (caption row, gaps, columns).
// On phones the two column tops are the likely LCP, so they also get fetchpriority="high".
const ratios = gallery.map((g) => g.data.image.height / g.data.image.width);
const CAPTION = 44; // .gallery-cap min-height (2.75rem)
const phone = (viewport: number) => columnStarts(ratios, { cols: 2, viewport, colGap: viewport < 640 ? 12 : 20, rowGap: 12, below: CAPTION });
const tablet = (viewport: number) => columnStarts(ratios, { cols: 3, viewport, colGap: 20, rowGap: 20, below: CAPTION });
const desktop = (viewport: number) => columnStarts(ratios, { cols: 4, viewport, colGap: 24, rowGap: 20, below: CAPTION });
const high = new Set([0, ...[360, 390, 430].flatMap(phone)]);
const eager = new Set([...high, ...[320, 640, 767].flatMap(phone), ...[768, 1024, 1279].flatMap(tablet), ...[1280, 1440].flatMap(desktop)]);
---
<div class="gallery" data-gallery>
  <div class="gallery-toolbar" data-gallery-filters>
    <div role="group" aria-labelledby="gallery-filter-label">
      <p id="gallery-filter-label" class="label-caps">Filter by occasion</p>
      <div class="filter-scroller">
        <ul class="filter-list">
          <li>
            <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">All</button>
          </li>
          {filters.map((f) => (
            <li>
              <button
                type="button"
                class="filter-chip"
                data-filter={f.id}
                data-book={f.book}
                data-page={f.page}
                data-phrase={f.phrase}
                data-plural={f.plural}
                aria-pressed="false"
              >{f.chip}</button>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <p class="gallery-status" role="status" data-gallery-status>Showing all {total} photos</p>
  </div>

  {anyPlaceholder && (
    <p class="placeholder-note gallery-note" data-gallery-placeholder>
      <strong>Placeholder —</strong> these images are stand-ins until real photos are added.
    </p>
  )}

  <ul class="gallery-grid" data-gallery-grid data-count={total} aria-label="Picnic photos">
    {items.map(({ g, occ, m, large, book }, i) => (
      <li class="gallery-item" data-gallery-item data-occasions={g.data.occasions.join(' ')} data-placeholder={g.data.placeholder ? 'true' : 'false'}>
        <a
          href={large.src}
          class="gallery-trigger"
          data-lightbox-item
          data-full={large.src}
          data-full-w={large.w}
          data-full-h={large.h}
          data-caption={g.data.alt}
          data-name={m.name}
          data-book={book}
          data-occasion={occ}
          data-page={m.page}
          data-page-label={m.page ? `More about ${m.plural}` : ''}
        >
          <Picture
            src={g.data.image}
            alt={g.data.alt}
            widths={[280, 420, 560, 720].filter((w) => w <= g.data.image.width)}
            sizes="(min-width: 1280px) 266px, (min-width: 768px) 30vw, 46vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading={eager.has(i) ? 'eager' : 'lazy'}
            fetchpriority={high.has(i) ? 'high' : undefined}
            decoding="async"
            class="gallery-img"
          />
          <span class="gallery-zoom" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7" /></svg>
          </span>
        </a>
        {m.page ? (
          <a href={m.page} class="gallery-cap">
            <span>{m.name}<span class="sr-only">: more about {m.plural}</span></span><Icon name="arrow-right" size={14} />
          </a>
        ) : (
          <p class="gallery-cap">{m.name}</p>
        )}
      </li>
    ))}
  </ul>

  <div class="gallery-next">
    <a
      href={bookUrl()}
      class="btn btn-primary btn-lg"
      data-gallery-book
      data-default-href={bookUrl()}
      data-default-label="Book your picnic"
      data-track="booking_cta"
      data-track-location="gallery_results"
    >Book your picnic</a>
    <a href="/occasions" class="link-arrow" data-gallery-page data-default-href="/occasions" data-default-label="Explore every occasion">
      <span data-gallery-page-label>Explore every occasion</span><Icon name="arrow-right" size={18} />
    </a>
  </div>
</div>

<script>
  import '../../scripts/gallery-filter';
</script>

<style>
  /* ── Filters ── */
  .gallery-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }
  .filter-scroller {
    position: relative;
    margin-top: 0.75rem;
    margin-inline: calc(var(--gutter) * -1);
  }
  /* Soft fade on the right edge hints that the strip scrolls on phones. */
  .filter-scroller::after {
    content: "";
    position: absolute;
    inset: 0 0 0.5rem auto;
    width: 2.5rem;
    background: linear-gradient(to right, color-mix(in srgb, var(--color-petal) 0%, transparent), var(--color-petal));
    pointer-events: none;
  }
  .filter-list {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.15rem var(--gutter) 0.5rem;
    /* No scroll-snap: it would pull a focused chip back under the fade. The end padding keeps a
       focused or pressed chip clear of the fade (gallery-filter.ts scrolls it into view). */
    scroll-padding-inline: var(--gutter) calc(var(--gutter) + 2.5rem);
    scrollbar-width: none;
  }
  .filter-list::-webkit-scrollbar { display: none; }
  .filter-list li { flex-shrink: 0; }
  .filter-list li:last-child { padding-right: 1.5rem; }
  @media (min-width: 1024px) {
    .filter-scroller { margin-inline: 0; }
    .filter-scroller::after { display: none; }
    .filter-list { flex-wrap: wrap; overflow: visible; padding-inline: 0; }
    .filter-list li:last-child { padding-right: 0; }
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-cocoa) 22%, transparent);
    background: color-mix(in srgb, var(--color-cream) 65%, transparent);
    color: var(--color-plum);
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .filter-chip:hover { border-color: var(--color-rose); background: var(--color-cream); }
  .filter-chip[aria-pressed="true"] {
    background: var(--color-cocoa);
    border-color: var(--color-cocoa);
    color: var(--color-cream);
  }
  /* High Contrast / forced colours drop the plum fill, so mark the active filter with the system highlight. */
  @media (forced-colors: active) {
    .filter-chip[aria-pressed="true"] {
      forced-color-adjust: none;
      background: Highlight;
      border-color: Highlight;
      color: HighlightText;
    }
  }

  .gallery-status {
    font-size: 0.95rem;
    color: var(--color-plum-soft);
  }

  .gallery-note { margin-top: 1.25rem; max-width: 40rem; }

  /* ── Masonry (CSS columns) ── */
  .gallery-grid {
    margin-top: 2rem;
    columns: 2;
    column-gap: 0.75rem;
  }
  @media (min-width: 640px) { .gallery-grid { column-gap: 1.25rem; } }
  @media (min-width: 768px) { .gallery-grid { columns: 3; margin-top: 2.5rem; } }
  @media (min-width: 1280px) { .gallery-grid { columns: 4; column-gap: 1.5rem; } }
  /* When a filter leaves only a few photos, keep them together instead of strung across empty columns. */
  .gallery-grid[data-count="1"] { columns: 1; max-width: 34rem; margin-inline: auto; }
  @media (min-width: 768px) {
    .gallery-grid[data-count="2"] { columns: 2; max-width: 50rem; margin-inline: auto; }
  }
  @media (min-width: 1280px) {
    .gallery-grid[data-count="3"] { columns: 3; max-width: 64rem; margin-inline: auto; }
  }

  /* Spacing here and the caption height are mirrored in columnStarts() above — keep them in step. */
  .gallery-item {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }
  @media (min-width: 768px) { .gallery-item { margin-bottom: 1.25rem; } }

  .gallery-trigger {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-petal-deep);
    cursor: zoom-in;
  }
  .gallery-trigger:focus-visible { outline-offset: 3px; }
  .gallery-img {
    width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .gallery-img { transition: transform 0.6s var(--ease-out-soft); }
    .gallery-trigger:hover .gallery-img { transform: scale(1.025); }
  }
  .gallery-zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-cream) 92%, transparent);
    color: var(--color-cocoa);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .gallery-trigger:hover .gallery-zoom,
  .gallery-trigger:focus-visible .gallery-zoom { opacity: 1; }
  @media (hover: none) { .gallery-zoom { opacity: 1; width: 2rem; height: 2rem; } }

  /* Occasion name under each photo; a link to that occasion's page when there is one. */
  .gallery-cap {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: 0.92rem;
    line-height: 1.3;
    color: var(--color-plum-soft);
  }
  a.gallery-cap {
    width: fit-content;
    max-width: 100%;
    text-decoration: none;
    transition: color 0.2s;
  }
  a.gallery-cap :global(svg) { flex-shrink: 0; transition: transform 0.25s var(--ease-out-soft); }
  a.gallery-cap:hover { color: var(--color-plum); }
  a.gallery-cap:hover > span:first-child {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  @media (prefers-reduced-motion: no-preference) {
    a.gallery-cap:hover :global(svg) { transform: translateX(3px); }
  }

  .gallery-next {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) {
    .gallery-next { flex-direction: row; align-items: center; gap: 2rem; }
  }
</style>

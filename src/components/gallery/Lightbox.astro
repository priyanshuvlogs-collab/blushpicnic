---
// Accessible photo lightbox (native <dialog>), driven by src/scripts/lightbox.ts.
// Opens from any [data-lightbox-item] link on the page; see GalleryBrowser.astro for the data
// attributes each photo carries. Without JavaScript the links simply open the large image.
import Icon from '../Icon.astro';
---
<dialog class="lightbox on-dark" aria-labelledby="lb-title" aria-describedby="lb-desc" data-lightbox>
  <div class="lb-inner" data-lb-dismiss>
    <div class="lb-top" data-lb-dismiss>
      <p class="lb-count" aria-hidden="true" data-lb-count></p>
      <button type="button" class="lb-btn lb-close" data-lb-close>
        <Icon name="close" size={22} label="Close photo" />
      </button>
    </div>

    <div class="lb-stage" data-lb-stage data-lb-dismiss>
      <img class="lb-img" alt="" data-lb-img decoding="async" />
      <button type="button" class="lb-btn lb-nav lb-prev" data-lb-prev>
        <Icon name="arrow-left" size={22} label="Previous photo" />
      </button>
      <button type="button" class="lb-btn lb-nav lb-next" data-lb-next>
        <Icon name="arrow-right" size={22} label="Next photo" />
      </button>
    </div>

    <div class="lb-bottom" data-lb-dismiss>
      <div class="lb-text">
        <h2 id="lb-title" class="lb-title" data-lb-title></h2>
        <p id="lb-desc" class="lb-desc" data-lb-desc></p>
      </div>
      <div class="lb-actions">
        <a href="/book" class="btn btn-light" data-lb-book data-track="booking_cta" data-track-location="gallery_lightbox">Book this look</a>
        <a href="/occasions" class="lb-link" data-lb-page></a>
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-lb-live></p>
  </div>
</dialog>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-cream);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .lightbox::backdrop {
    background: rgb(33 10 26 / 0.94);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] { animation: lb-in 0.25s var(--ease-out-soft); }
    .lightbox[open]::backdrop { animation: lb-fade 0.25s ease-out; }
    @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  }

  .lb-inner {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
    padding: max(0.5rem, env(safe-area-inset-top)) var(--gutter) max(1rem, env(safe-area-inset-bottom));
    gap: 0.5rem;
  }

  .lb-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .lb-count {
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    color: rgb(255 253 252 / 0.8);
    letter-spacing: 0.02em;
  }

  .lb-btn {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: var(--color-cream);
    background: rgb(255 253 252 / 0.1);
    border: 1px solid rgb(255 253 252 / 0.25);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .lb-btn:hover { background: rgb(255 253 252 / 0.2); border-color: rgb(255 253 252 / 0.5); }
  .lb-close { margin-right: -0.25rem; }

  .lb-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    height: 100%;
    touch-action: pan-y pinch-zoom;
  }
  @media (min-width: 768px) {
    .lb-stage { padding-inline: 4.75rem; }
  }
  .lb-img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 10px;
    background: rgb(255 253 252 / 0.06);
    user-select: none;
    -webkit-user-drag: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lb-img { transition: opacity 0.25s ease-out, filter 0.35s ease-out; }
  }
  /* While the large file loads, the (already cached) grid image stands in, softly. */
  .lb-stage[data-loading="true"] .lb-img { filter: blur(6px); opacity: 0.85; }

  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgb(33 10 26 / 0.45);
    backdrop-filter: blur(4px);
  }
  .lb-prev { left: 0.25rem; }
  .lb-next { right: 0.25rem; }
  @media (min-width: 768px) {
    .lb-nav { width: 3.5rem; height: 3.5rem; background: rgb(255 253 252 / 0.1); }
    .lb-prev { left: 0; }
    .lb-next { right: 0; }
  }

  .lb-bottom {
    display: grid;
    gap: 0.9rem;
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
    padding-top: 0.5rem;
  }
  @media (min-width: 768px) {
    .lb-bottom { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2rem; }
  }
  .lb-title {
    color: var(--color-cream);
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.7rem);
    line-height: 1.15;
  }
  .lb-desc {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgb(255 253 252 / 0.8);
    max-width: 60ch;
  }
  .lb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }
  .lb-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-cream);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .lb-link:hover { text-decoration-color: var(--color-cream); }
  .lb-link:empty { display: none; }

  @media (max-height: 520px) {
    .lb-desc { display: none; }
    .lb-bottom { gap: 0.5rem; }
  }
</style>

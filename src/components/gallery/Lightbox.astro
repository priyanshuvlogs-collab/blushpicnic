---
// Accessible photo lightbox (native <dialog>), driven by src/scripts/lightbox.ts.
// Opens from any [data-lightbox-item] link on the page; see GalleryBrowser.astro for the data
// attributes each photo carries. Without JavaScript the links simply open the large image.
// The <img> itself is created by the script on first use, so the static page has no image
// without a src; the title and occasion link carry real default text for the same reason.
import Icon from '../Icon.astro';
---
<dialog class="lightbox on-dark" aria-labelledby="lb-title" aria-describedby="lb-desc" data-lightbox>
  <div class="lb-inner" data-lb-dismiss>
    <div class="lb-top" data-lb-dismiss>
      <p class="lb-count" aria-hidden="true" data-lb-count></p>
      <button type="button" class="lb-btn lb-close" data-lb-close>
        <Icon name="close" size={22} label="Close photo" />
      </button>
    </div>

    <div class="lb-stage" data-lb-stage data-lb-dismiss>
      <button type="button" class="lb-btn lb-nav lb-prev" data-lb-prev>
        <Icon name="arrow-left" size={22} label="Previous photo" />
      </button>
      <button type="button" class="lb-btn lb-nav lb-next" data-lb-next>
        <Icon name="arrow-right" size={22} label="Next photo" />
      </button>
    </div>

    <div class="lb-bottom" data-lb-dismiss>
      <div class="lb-text">
        <h2 id="lb-title" class="lb-title" data-lb-title>Photo</h2>
        <p id="lb-desc" class="lb-desc" data-lb-desc></p>
      </div>
      <div class="lb-actions">
        <a href="/book" class="btn btn-light" data-lb-book data-track="booking_cta" data-track-location="gallery_lightbox">Book this look</a>
        <a href="/occasions" class="lb-link" data-lb-page hidden>Explore every occasion</a>
      </div>
    </div>

    <p class="sr-only" aria-live="polite" data-lb-live></p>
  </div>
</dialog>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    /* The dark scrim lives on the dialog itself (not ::backdrop) so its colour is the real,
       measurable background of the text; the backdrop only blurs the page behind. Brand Cocoa 900,
       the guide's ground for the reversed logo. */
    background: color-mix(in srgb, var(--color-cocoa) 97%, transparent);
    color: var(--color-cream);
    overflow: hidden;
    overscroll-behavior: contain;
  }
  .lightbox::backdrop {
    background: transparent;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] { animation: lb-in 0.25s var(--ease-out-soft); }
    .lightbox[open]::backdrop { animation: lb-fade 0.25s ease-out; }
    @keyframes lb-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  }

  .lb-inner {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100%;
    padding: max(0.5rem, env(safe-area-inset-top)) var(--gutter) max(1rem, env(safe-area-inset-bottom));
    gap: 0.5rem;
  }

  .lb-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  /* "2 / 32" in the brand's spaced small caps, in Blush 300 (8.8:1 on cocoa). */
  .lb-count {
    font-size: 0.85rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: 0.18em;
    color: var(--color-blush-300);
  }

  .lb-btn {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: var(--color-cream);
    background: color-mix(in srgb, var(--color-cream) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-blush-300) 40%, transparent);
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s;
  }
  .lb-btn:hover {
    background: color-mix(in srgb, var(--color-cream) 16%, transparent);
    border-color: var(--color-blush-300);
  }
  .lb-close { margin-right: -0.25rem; }

  .lb-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    height: 100%;
    touch-action: pan-y pinch-zoom;
  }
  @media (min-width: 768px) {
    .lb-stage { padding-inline: 4.75rem; }
  }
  /* .lb-img is added by lightbox.ts, hence :global (scoped styles only reach markup in this file). */
  .lb-stage :global(.lb-img) {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-cream) 6%, transparent);
    user-select: none;
    -webkit-user-drag: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lb-stage :global(.lb-img) { transition: opacity 0.25s ease-out, filter 0.35s ease-out; }
  }
  /* While the large file loads, the (already cached) grid image stands in, softly. */
  .lb-stage[data-loading="true"] :global(.lb-img) { filter: blur(6px); opacity: 0.85; }

  .lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: color-mix(in srgb, var(--color-cocoa) 55%, transparent);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .lb-prev { left: 0.25rem; }
  .lb-next { right: 0.25rem; }
  @media (min-width: 768px) {
    .lb-nav { width: 3.5rem; height: 3.5rem; background: color-mix(in srgb, var(--color-cream) 8%, transparent); }
    .lb-prev { left: 0; }
    .lb-next { right: 0; }
  }

  .lb-bottom {
    display: grid;
    gap: 0.9rem;
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
    padding-top: 0.5rem;
  }
  @media (min-width: 768px) {
    .lb-bottom { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2rem; }
  }
  .lb-title {
    color: var(--color-cream);
    font-size: clamp(1.6rem, 1.4rem + 0.7vw, 2rem);
    line-height: 1.1;
  }
  .lb-desc {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-cream) 82%, transparent);
    max-width: 60ch;
  }
  .lb-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }
  .lb-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-cream);
    font-weight: 600;
    font-size: 0.98rem;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .lb-link:hover { text-decoration-color: var(--color-blush-300); }
  .lb-link[hidden] { display: none; }

  /* Short screens (landscape phones, a zoomed-in browser): the photo must never shrink to a
     thumbnail under the title and buttons. */
  @media (max-height: 30rem) and (max-width: 39.99rem) {
    /* Narrow too (e.g. 400% zoom): stack at full size and let the dialog scroll. */
    .lightbox { overflow-y: auto; }
    .lb-inner { height: auto; min-height: 100%; grid-template-rows: auto auto auto; }
    .lb-stage { height: auto; }
    .lb-stage :global(.lb-img) { max-height: 78vh; max-height: 78dvh; }
  }
  @media (max-height: 30rem) and (min-width: 40rem) {
    /* Wide (landscape phones): the photo on the left, its words and actions beside it. */
    .lb-inner {
      grid-template-columns: minmax(0, 1fr) minmax(13rem, 17rem);
      grid-template-rows: auto minmax(0, 1fr);
      column-gap: 1.5rem;
    }
    .lb-top { grid-column: 1 / -1; }
    .lb-bottom {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      gap: 1rem;
      padding-top: 0;
      overflow-y: auto;
    }
  }
</style>

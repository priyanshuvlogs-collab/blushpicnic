---
// Short "good to know" column beside (desktop) or below (mobile) the booking form.
// Every line comes from settings.yaml: reply time, booking + security deposit summaries, phone.
import Icon from '../Icon.astro';
import { getSettings, smsUrl, telUrl } from '../../lib/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const s = await getSettings();
// settings.yaml is typed with straight apostrophes ("It’s"); show typographic ones like the rest of the site.
const curly = (t: string) => t.replace(/(\w)'(\w)/g, '$1’$2');
---
<section class:list={['bk-reassure', className]} aria-labelledby="bk-reassure-title">
  <h2 id="bk-reassure-title" class="bk-reassure-heading">Good to know</h2>
  <ul class="bk-reassure-list">
    <li>
      <Icon name="clock" size={20} class="bk-reassure-icon" />
      <div>
        <p class="bk-reassure-title">We reply {s.replyTime}</p>
        <p>By text or email, with availability and your quote.</p>
      </div>
    </li>
    <li>
      <Icon name="calendar" size={20} class="bk-reassure-icon" />
      <div>
        <p class="bk-reassure-title">Holding your date</p>
        <p>{curly(s.deposit.summary)}</p>
      </div>
    </li>
    <li data-security-deposit>
      <Icon name="sparkle" size={20} class="bk-reassure-icon" />
      <div>
        <p class="bk-reassure-title">Refundable security deposit</p>
        <p>{curly(s.securityDeposit.summary)}</p>
      </div>
    </li>
    <li>
      <Icon name="message" size={20} class="bk-reassure-icon" />
      <div>
        <p class="bk-reassure-title">Prefer to text?</p>
        <p>
          <a href={smsUrl(s)} class="bk-link" data-track="click_text">Text {s.phoneDisplay}</a>
          <span class="whitespace-nowrap">or <a href={telUrl(s)} class="bk-link" data-track="click_call">call</a>.</span>
        </p>
      </div>
    </li>
  </ul>
  <p class="bk-reassure-foot">
    <a href="/policies" class="bk-link">Booking policies</a>
    <span aria-hidden="true">·</span>
    <a href="/privacy" class="bk-link">Privacy</a>
  </p>
</section>

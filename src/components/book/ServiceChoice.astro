---
// "What can we set up for you?" as rich radio cards: the service's name and its one-line "short"
// from services.yaml (via the form schema). Like PackageChoice, the visual card is a sibling of the
// (invisible, full-size) radio, so checked/focus states need no :has().
// A service with dm: true (custom hampers) gets a line underneath offering an Instagram DM instead;
// with JS it only shows while that service is chosen (booking.ts toggles .is-shown).
import type { FormSchema, ResolvedField } from '../../lib/form';
import { getSettings, igDmUrl } from '../../lib/site';

interface Props {
  field: ResolvedField;
  services: FormSchema['services'];
}
const { field: f, services } = Astro.props;
const s = await getSettings();
const byId = new Map(services.map((x) => [x.id, x]));
const id = `f-${f.id}`;
const helpId = f.help ? `${id}-help` : undefined;
---
<fieldset class="bk-field is-radio is-service" data-field={f.id} data-type={f.type} aria-describedby={helpId}>
  <legend class="bk-label bk-label-lg">{f.label}{!f.required && <span class="bk-optional"> (optional)</span>}</legend>
  {f.help && <p id={helpId} class="bk-help">{f.help}</p>}
  <p id={`${id}-error`} class="bk-error" data-field-error hidden>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5h.01" /></svg>
    <span data-error-text></span>
  </p>
  <div class="bk-svcs">
    {(f.options ?? []).map((o, i) => {
      const d = byId.get(o.value);
      return (
        <label class="bk-svc" for={`${id}-${i}`}>
          <input id={`${id}-${i}`} type="radio" name={f.id} value={o.value} required={f.required} class="bk-svc-input" />
          <span class="bk-svc-face">
            <span class="bk-pkg-dot bk-svc-dot" aria-hidden="true"></span>
            <span class="bk-svc-body">
              <span class="bk-svc-name">{o.label}</span>
              {d?.short && <span class="bk-svc-short">{d.short}</span>}
            </span>
          </span>
        </label>
      );
    })}
  </div>
  {services
    .filter((x) => x.dm)
    .map((x) => (
      <p class="bk-svc-dm" data-dm-for={x.id}>
        {x.name}: prefer Instagram? <a href={igDmUrl(s)} class="bk-link" rel="noopener" data-track="click_instagram">DM us {s.instagramHandle}</a> with your vision instead and we’ll take it from there.
      </p>
    ))}
</fieldset>

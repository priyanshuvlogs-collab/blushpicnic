---
// "On this page" navigation for long pages (policies, privacy, FAQ). Two columns of links on phones,
// a sticky list beside the content on desktop. The section in view is marked as you scroll.
interface Props {
  items: { id: string; label: string }[];
  label?: string;
  /** unique per page if there is more than one */
  id?: string;
  class?: string;
}
const { items, label = 'On this page', id = 'page-toc', class: className = '' } = Astro.props;
const labelId = `${id}-label`;
---
<nav aria-labelledby={labelId} class:list={['page-toc', className]} data-page-toc>
  <p id={labelId} class="label-caps">{label}</p>
  <ul class="mt-2 grid grid-cols-2 gap-x-6 gap-y-1.5 sm:grid-cols-3 lg:mt-4 lg:grid-cols-1 lg:gap-0 lg:border-l lg:border-line">
    {items.map((item) => (
      <li>
        <a href={`#${item.id}`} class="toc-link" data-toc-link={item.id}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Mark the section being read (desktop sticky list): the last heading that has scrolled past
  // ~35% of the viewport. Nothing is marked above the first section. Purely a visual aid.
  for (const nav of document.querySelectorAll<HTMLElement>('[data-page-toc]')) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const a of nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')) links.set(a.dataset.tocLink!, a);
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    if (!targets.length) continue;

    let current: string | null = null;
    const update = () => {
      const line = window.innerHeight * 0.35;
      let active: HTMLElement | undefined;
      for (const t of targets) if (t.getBoundingClientRect().top <= line) active = t;
      // At the very bottom, the last section wins even if its heading never reaches the line.
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
      const lastTop = targets[targets.length - 1].getBoundingClientRect().top;
      if (atEnd && lastTop < window.innerHeight) active = targets[targets.length - 1];
      const id = active?.id ?? null;
      if (id === current) return;
      current = id;
      for (const [key, a] of links) {
        if (key === id) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      }
    };
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>

<style>
  .toc-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--color-cocoa);
    text-decoration: underline;
    text-decoration-color: var(--color-blush-300);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    line-height: 1.3;
    /* transparent from the start, so crossing the desktop breakpoint never flashes a dark rule */
    border-left: 0 solid transparent;
  }
  .toc-link:hover { text-decoration-color: var(--color-gold); }
  @media (min-width: 1024px) {
    .toc-link {
      min-height: 2.6rem;
      margin-left: -1px;
      padding-left: 1.1rem;
      border-left-width: 2px;
      text-decoration: none;
      color: var(--color-plum-soft);
    }
    @media (prefers-reduced-motion: no-preference) {
      .toc-link { transition: color 0.2s, border-color 0.2s; }
    }
    .toc-link:hover { color: var(--color-cocoa); text-decoration: underline; text-decoration-color: var(--color-gold); }
    /* The section being read: cocoa text with a Rose 700 rule (5.3:1 / 4.7:1 on linen / blush). */
    .toc-link[aria-current] {
      color: var(--color-cocoa);
      font-weight: 600;
      border-left-color: var(--color-rose);
    }
  }
</style>

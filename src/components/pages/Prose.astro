---
// Long-form copy from src/content/pages/*.md (about, policies, privacy): fills {tokens} from
// settings.yaml, drops the editing notes kept in HTML comments, and applies the prose styles.
// Pass the entry's rendered HTML as `html`, or render <Content /> into the slot.
import { getSettings } from '../../lib/site';
import { fillTokens } from './prose';

interface Props {
  html?: string;
  /** hairline above each section heading (policies, privacy) */
  ruled?: boolean;
  class?: string;
}
const { html: input, ruled = false, class: className = '' } = Astro.props;
const s = await getSettings();
const raw = input ?? (Astro.slots.has('default') ? await Astro.slots.render('default') : '');
const html = fillTokens(raw.replace(/<!--[\s\S]*?-->/g, ''), s);
---
<div class:list={['prose-blush page-prose', ruled && 'page-prose--ruled', className]} set:html={html} />

<style>
  /* Anchor targets sit clear of the sticky header. */
  .page-prose :global(h2) { scroll-margin-top: 6rem; }
  .page-prose :global(h2:first-child) { margin-top: 0; }
  .page-prose :global(h2 + p) { margin-top: 0.9em; }
  .page-prose :global(a) {
    color: var(--color-plum);
    text-decoration-line: underline;
    text-underline-offset: 0.22em;
  }
  .page-prose :global(a:hover) { text-decoration-color: var(--color-plum); }
  .page-prose :global(.placeholder-note) { max-width: 40rem; }
  .page-prose--ruled :global(h2:not(:first-child)) {
    margin-top: 2.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-line);
  }
  /* A note before the first heading (e.g. "last updated") doesn't need a rule under it. */
  .page-prose--ruled :global(.placeholder-note:first-child + h2) {
    margin-top: 2rem;
    padding-top: 0;
    border-top: 0;
  }
  .page-prose :global(* + .placeholder-note) { margin-top: 1.25em; }
  .page-prose :global(.placeholder-note + *) { margin-top: 1.4em; }
  .page-prose :global(.placeholder-note ul) { margin-top: 0.6em; }
  .page-prose :global(.placeholder-note li + li) { margin-top: 0.3em; }
</style>

---
// Blush Picnic wordmark. TEMPORARY text version — replaced by the outlined SVG
// generated by scripts/make-brand.mjs (same props, same footprint).
interface Props {
  class?: string;
  /** height in px of the cap height area */
  size?: 'sm' | 'md' | 'lg';
}
const { class: className = '', size = 'md' } = Astro.props;
const fs = { sm: '1.35rem', md: '1.6rem', lg: '2.4rem' }[size];
---
<span class={`font-display inline-block leading-none tracking-tight ${className}`} style={`font-size:${fs}`}>Blush Picnic</span>

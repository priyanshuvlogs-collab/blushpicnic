---
// The Blush Picnic logo (Logo Guide, "Concept 06 · The Basket"), from the outlined SVGs in
// public/brand/. Served as files so every page shares one cached copy.
//   variant "horizontal"        — website header (guide: min 240px wide on screen)
//   variant "stacked-reversed"  — dark grounds (footer on cocoa)
//   variant "stacked"           — primary logo, light grounds
// The image is decorative (alt=""); a visually hidden name follows it. Inside a link with an
// aria-label the label wins; used bare the element still has a name.
import { getSettings } from '../lib/site';
import { versioned } from '../lib/brand';

interface Props {
  variant?: 'horizontal' | 'stacked' | 'stacked-reversed';
  /** Rendered width in px (height follows the logo's proportions). */
  width?: number;
  class?: string;
  /** Above-the-fold logo: load eagerly. */
  eager?: boolean;
}

// viewBox sizes of the files in public/brand/ (keep in step with scripts/make-brand.mjs).
// versioned() adds the file's content hash, so a replaced logo isn't hidden by the 30-day cache.
const FILES = {
  horizontal: { src: versioned('/brand/logo-horizontal.svg'), w: 291.48, h: 59.16 },
  stacked: { src: versioned('/brand/logo-stacked.svg'), w: 288.36, h: 190.97 },
  'stacked-reversed': { src: versioned('/brand/logo-stacked-reversed.svg'), w: 95.37, h: 63.38 },
} as const;

const { variant = 'horizontal', width = 250, class: className = '', eager = false } = Astro.props;
const f = FILES[variant];
const height = Math.round((width * f.h) / f.w);
const s = await getSettings();
---
<img
  src={f.src}
  alt=""
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class:list={['wordmark block h-auto max-w-full', className]}
/><span class="sr-only">{s.name}</span>

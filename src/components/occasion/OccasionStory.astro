---
// The occasion's long-form copy (markdown, passed in the default slot) beside a "Good to know"
// panel with the practical facts visitors look for: where, price notes, deposit, reply time,
// policies. Every fact comes from settings.yaml so it stays in sync site-wide.
import Icon from '../Icon.astro';
import { getSettings, smsUrl, telUrl } from '../../lib/site';

const s = await getSettings();

const facts = [
  {
    icon: 'map-pin',
    title: 'Where we set up',
    text: `Parks, beaches, backyards, homes and indoor venues across ${s.serviceArea}. Not sure where yet? We can suggest a spot.`,
  },
  {
    icon: 'sparkle',
    title: 'What we handle',
    text: 'Delivery, setup, styling and clean-up. Everything arrives with us and leaves with us.',
  },
  {
    icon: 'clock',
    title: 'Hearing back',
    text: `We reply ${s.replyTime} with availability and your quote.`,
  },
  {
    icon: 'calendar',
    title: 'Holding your date',
    text: s.deposit.summary,
  },
  {
    icon: 'check',
    title: 'Prices',
    text: `Every price is a starting price, ${s.taxNote}. ${s.locationNote}`,
  },
] as const;
---
<section class="section-y">
  <div class="container-x grid gap-x-16 gap-y-14 lg:grid-cols-12">
    <div class="occasion-story prose-blush lg:col-span-7">
      <slot />
    </div>

    <aside aria-labelledby="good-to-know" class="lg:col-span-5">
      <div class="rounded-[var(--radius-card)] border border-line bg-cream p-6 sm:p-8 lg:sticky lg:top-28">
        <h2 id="good-to-know" class="text-[1.65rem] md:text-[1.9rem]">Good to know</h2>
        <dl class="mt-5 grid gap-5">
          {facts.map((f) => (
            <div class="relative pl-[2.1rem]">
              <dt class="font-semibold">
                <Icon name={f.icon} size={20} class="absolute left-0 top-[0.2em] text-sage-ink" />{f.title}
              </dt>
              <dd class="mt-0.5 text-[0.98rem] text-plum-soft">{f.text}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-6 border-t border-line pt-4">
          <a href="/policies" class="link-arrow">Weather, changes &amp; policies<Icon name="arrow-right" size={18} /></a>
          <ul class="mt-1 grid">
            <li><a href={smsUrl(s)} class="story-contact" data-track="click_text" data-track-location="occasion_aside"><Icon name="message" size={18} />Text us a question</a></li>
            <li><a href={telUrl(s)} class="story-contact" data-track="click_call" data-track-location="occasion_aside"><Icon name="phone" size={18} />Call {s.phoneDisplay}</a></li>
          </ul>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .occasion-story > :global(:first-child) { margin-top: 0; }
  .occasion-story :global(h2) { scroll-margin-top: 6rem; }

  /* The "how to plan it" list in each occasion's copy, set as quiet numbered steps. */
  .occasion-story :global(ol) {
    list-style: none;
    padding: 0;
    counter-reset: step;
    border-top: 1px solid var(--color-line);
  }
  .occasion-story :global(ol > li) {
    counter-increment: step;
    position: relative;
    padding: 1.1rem 0 1.15rem 3.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  .occasion-story :global(ol > li)::before {
    content: counter(step);
    position: absolute;
    left: 0.2rem;
    top: 0.85rem;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-gold-ink);
  }
  .occasion-story :global(ol > li strong) { display: block; color: var(--color-plum); }

  .story-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-plum);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .story-contact:hover { text-decoration-color: var(--color-plum); }
</style>

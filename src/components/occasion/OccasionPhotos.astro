---
// Two to four gallery photos tagged with this occasion, in an offset editorial layout,
// with "Book this look" and a link to the gallery filtered to this occasion.
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import AiTag from '../AiTag.astro';
import { isAiPhoto } from '../../lib/photos';
import { getGallery, getSettings, bookUrl, type Occasion, type Package } from '../../lib/site';
import { picnicPhrasePlural, capitalize } from './text';

interface Props {
  entry: Occasion;
  pkg: Package;
}
const { entry, pkg } = Astro.props;
const s = await getSettings();
const items = (await getGallery()).filter((g) => g.data.occasions.includes(entry.id)).slice(0, 4);
// Two photos fill a landscape (4:3) slot, then a portrait (4:5) one: the wider photo goes first, so
// neither crop cuts away its subject.
const ratio = (g: (typeof items)[number]) => g.data.image.width / g.data.image.height;
if (items.length === 2 && ratio(items[1]) > ratio(items[0])) items.reverse();
const anyAi = items.some((g) => isAiPhoto(g.data.image));
const anyPlaceholder = items.some((g) => g.data.placeholder && !isAiPhoto(g.data.image));
const plural = picnicPhrasePlural(entry);

// Layout slots: [mobile classes, desktop classes, aspect ratio, sizes]
const slots = [
  { cls: 'col-span-12 md:col-span-7', aspect: '4/3', sizes: '(min-width: 1280px) 680px, (min-width: 768px) 56vw, 100vw' },
  { cls: 'col-span-10 col-start-3 md:col-span-5 md:col-start-auto md:mt-28', aspect: '4/5', sizes: '(min-width: 1280px) 480px, (min-width: 768px) 40vw, 82vw' },
  { cls: 'col-span-6 md:col-span-5', aspect: '4/5', sizes: '(min-width: 1280px) 480px, (min-width: 768px) 40vw, 48vw' },
  { cls: 'col-span-6 md:col-span-7 md:-mt-24 self-end', aspect: '4/3', sizes: '(min-width: 1280px) 680px, (min-width: 768px) 56vw, 48vw' },
];
const single = items.length === 1;
const pair = items.length === 2;
---
{items.length > 0 && (
  <section aria-labelledby="photos-title" class="section-y">
    <div class="container-x">
      <div class="grid gap-4 lg:grid-cols-12 lg:items-end lg:gap-10">
        <h2 id="photos-title" class="lg:col-span-6">{capitalize(plural)}, styled</h2>
        <p class="measure text-plum-soft lg:col-span-6 lg:pb-1">
          See a look you love? Book it, then tell us your colours and the message you'd like to see. We'll style it around you.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-12 items-start gap-x-3 gap-y-6 sm:gap-x-5 md:mt-14 md:gap-x-8 md:gap-y-10">
        {items.map((g, i) => {
          const slot = single ? { cls: 'col-span-12 md:col-span-8 md:col-start-3', aspect: '3/2', sizes: '(min-width: 1280px) 780px, (min-width: 768px) 66vw, 100vw' } : slots[i];
          return (
            <figure class:list={['relative', slot.cls, pair && i === 1 && 'md:row-span-2']}>
              <Picture
                src={g.data.image}
                alt={g.data.alt}
                widths={[360, 540, 720, 960, 1200].filter((w) => w <= g.data.image.width)}
                sizes={slot.sizes}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                loading="lazy"
                class="w-full rounded-[var(--radius-card)] bg-petal-deep object-cover"
                style={`aspect-ratio:${slot.aspect}`}
              />
              <AiTag src={g.data.image} />
            </figure>
          );
        })}

        {/* With two photos, the note and actions sit under the first one, beside the dropped second photo. */}
        <div class:list={['col-span-12', pair ? 'md:col-span-7 md:col-start-1 md:row-start-2' : single && 'md:col-span-8 md:col-start-3']}>
          {anyAi && (
            <p class="placeholder-note mb-8 max-w-2xl">
              <strong>AI illustrations —</strong> these images were created with AI to show the style of {plural}. Photos from real Blush Picnic picnics are coming soon.
            </p>
          )}
          {anyPlaceholder && (
            <p class="placeholder-note mb-8 max-w-2xl">
              <strong>Placeholder —</strong> these are stand-in images. Real photos of {plural} replace them once they're added to the gallery.
            </p>
          )}

          <div class="flex flex-col items-start gap-1 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-8 sm:gap-y-2">
            <a
              href={bookUrl({ occasion: entry.id, package: pkg.id })}
              class="btn btn-primary"
              data-track="booking_cta"
              data-track-location="occasion_photos"
              data-track-occasion={entry.id}
              data-track-package={pkg.id}
            >Book this look</a>
            <a href={`/gallery?occasion=${encodeURIComponent(entry.id)}`} class="link-arrow">See more in the gallery<Icon name="arrow-right" size={18} /></a>
            <a href={s.instagramUrl} rel="noopener" class="link-arrow" data-track="click_instagram"><Icon name="instagram" size={20} />{s.instagramHandle}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

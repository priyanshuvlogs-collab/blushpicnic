---
// One group on /occasions (Romance, Celebrations…). Three layouts so the index reads like an
// editorial contents page rather than a grid of identical cards:
//   stagger — portrait photos in columns, the middle column dropped
//   feature — one large lead photo beside smaller landscape crops
//   rows    — compact rows with a thumbnail, for scanning
import { Picture } from 'astro:assets';
import Icon from '../Icon.astro';
import { getSettings, money, occasionUrl, type Occasion, type Package } from '../../lib/site';
import { picnicPhrasePlural, capitalize, excerpt } from './text';

interface Props {
  id: string;
  title: string;
  intro: string;
  items: Occasion[];
  packages: Map<string, Package>;
  layout: 'stagger' | 'feature' | 'rows';
  tone?: 'petal' | 'cream';
}
const { id, title, intro, items, packages, layout, tone = 'petal' } = Astro.props;
const s = await getSettings();
const headingId = `group-${id}`;

const priceLine = (o: Occasion) => {
  const p = packages.get(o.data.recommendedPackage)!;
  return `Starting at ${money(p.data.priceFrom)} ${p.data.guestsLabel}, ${s.taxNote}`;
};
const label = (o: Occasion) => capitalize(picnicPhrasePlural(o));
const w = (o: Occasion, list: number[]) => list.filter((x) => x <= o.data.heroImage.width);
---
<section id={id} aria-labelledby={headingId} class:list={['section-y scroll-mt-16', tone === 'cream' && 'bg-cream']}>
  <div class="container-x">
    <div class="grid gap-4 lg:grid-cols-12 lg:items-end lg:gap-10">
      <h2 id={headingId} class="lg:col-span-5">{title}</h2>
      <p class="measure text-plum-soft lg:col-span-7 lg:pb-1">{intro}</p>
    </div>

    {layout === 'stagger' && (
      <ul class="stagger mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:mt-14 lg:grid-cols-3 lg:gap-x-10 lg:gap-y-14" role="list">
        {items.map((o) => (
          <li class="occ group relative">
            <Picture
              src={o.data.heroImage}
              alt=""
              widths={w(o, [240, 360, 480, 640, 800])}
              sizes="(min-width: 1280px) 360px, (min-width: 1024px) 29vw, 46vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="lazy"
              class="occ-img aspect-[4/5] w-full rounded-[var(--radius-card)] bg-petal-deep object-cover"
            />
            <h3 class="mt-4 text-[1.3rem] sm:text-[1.5rem] lg:text-[1.7rem]">
              <a href={occasionUrl(o)} class="occ-link no-underline">{label(o)}</a>
            </h3>
            <p class="mt-2 hidden text-plum-soft sm:block">{excerpt(o.data.lede, 120)}</p>
            <p class="mt-2 text-[0.9rem] leading-snug text-plum-soft sm:text-[0.95rem]">{priceLine(o)}</p>
          </li>
        ))}
      </ul>
    )}

    {layout === 'feature' && (
      <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 md:mt-14 lg:grid-cols-12 lg:gap-x-10 lg:gap-y-12" role="list">
        {items.map((o, i) => (
          <li class:list={['occ group relative', i === 0 ? 'col-span-2 lg:col-span-6 lg:row-span-2' : 'lg:col-span-3']}>
            <Picture
              src={o.data.heroImage}
              alt=""
              widths={i === 0 ? w(o, [480, 640, 800, 1000, 1200]) : w(o, [240, 360, 480, 640])}
              sizes={i === 0 ? '(min-width: 1280px) 560px, (min-width: 1024px) 46vw, 100vw' : '(min-width: 1280px) 260px, (min-width: 1024px) 21vw, 46vw'}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="lazy"
              class:list={['occ-img w-full rounded-[var(--radius-card)] bg-petal-deep object-cover', i === 0 ? 'aspect-[4/3] lg:aspect-[5/6]' : 'aspect-square']}
            />
            <h3 class:list={['mt-4', i === 0 ? 'text-[1.7rem] md:text-[2.1rem]' : 'text-[1.3rem] sm:text-[1.45rem]']}>
              <a href={occasionUrl(o)} class="occ-link no-underline">{label(o)}</a>
            </h3>
            {i === 0
              ? <p class="measure mt-2 text-plum-soft">{excerpt(o.data.lede, 170)}</p>
              : <p class="mt-2 hidden text-[0.95rem] text-plum-soft xl:block">{excerpt(o.data.lede, 80)}</p>}
            <p class="mt-2 text-[0.9rem] leading-snug text-plum-soft sm:text-[0.95rem]">{priceLine(o)}</p>
          </li>
        ))}
      </ul>
    )}

    {layout === 'rows' && (
      <ul class="mt-8 grid border-t border-line md:mt-12 lg:grid-cols-2 lg:gap-x-12 lg:border-t-0" role="list">
        {items.map((o) => (
          <li class="occ group relative flex items-center gap-5 border-b border-line py-5 sm:gap-7 lg:border-b-0 lg:border-t lg:py-7">
            <Picture
              src={o.data.heroImage}
              alt=""
              widths={w(o, [160, 240, 320, 400])}
              sizes="(min-width: 640px) 144px, 104px"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="lazy"
              pictureAttributes={{ class: 'block w-[6.5rem] shrink-0 sm:w-36' }}
              class="occ-img aspect-[4/5] w-full rounded-[14px] bg-petal-deep object-cover"
            />
            <div class="min-w-0">
              <h3 class="text-[1.3rem] sm:text-[1.55rem]">
                <a href={occasionUrl(o)} class="occ-link no-underline">{label(o)}</a>
              </h3>
              <p class="mt-1.5 hidden text-plum-soft sm:block">{excerpt(o.data.lede, 110)}</p>
              <p class="mt-1.5 text-[0.9rem] leading-snug text-plum-soft sm:text-[0.95rem]">{priceLine(o)}</p>
            </div>
            <Icon name="arrow-right" size={20} class="ml-auto hidden shrink-0 text-plum-soft motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:translate-x-1 sm:block" />
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  /* Middle column drops down on wide screens; every second item on phones. */
  @media (max-width: 1023.98px) {
    .stagger > li:nth-child(2n) { margin-top: 2.5rem; }
  }
  @media (min-width: 1024px) {
    .stagger > li:nth-child(3n + 2) { margin-top: 4.5rem; }
  }

  /* Whole item is clickable; the heading link stays the accessible name. */
  .occ-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-card);
  }
  .occ-link:focus-visible { outline: none; }
  .occ-link:focus-visible::after {
    outline: 3px solid var(--color-plum);
    outline-offset: 4px;
  }
  .occ-link { text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 0.2em; transition: text-decoration-color 0.2s; }
  .occ:hover .occ-link { text-decoration-color: var(--color-gold); }

  @media (prefers-reduced-motion: no-preference) {
    .occ-img { transition: transform 0.6s var(--ease-out-soft), filter 0.6s; }
    .occ:hover .occ-img { filter: saturate(1.06) brightness(1.02); }
  }
</style>

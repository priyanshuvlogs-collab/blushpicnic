---
// On an occasion page, the site-wide "Book" buttons (header, mobile menu, sticky bar) should open the
// form with this occasion and package already chosen. Progressive enhancement: without JS they still
// go to /book. (Workaround until Header/StickyBar accept a booking context prop.)
import { bookUrl } from '../../lib/site';
interface Props {
  occasion: string;
  package?: string;
}
const { occasion, package: pkg } = Astro.props;
---
<span hidden data-book-context={bookUrl({ occasion, package: pkg })}></span>
<script>
  const href = document.querySelector<HTMLElement>('[data-book-context]')?.dataset.bookContext;
  if (href) {
    document
      .querySelectorAll<HTMLAnchorElement>('[data-header] a[href="/book"], [data-sticky-bar] a[href="/book"]')
      .forEach((a) => a.setAttribute('href', href));
  }
</script>

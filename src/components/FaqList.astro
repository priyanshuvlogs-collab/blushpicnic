---
// Accessible accordion built on <details>/<summary>: keyboard and screen-reader friendly with no JS.
import Icon from './Icon.astro';
import { inlineMd } from '../lib/site';
interface Props {
  items: { q: string; a: string }[];
  /** heading level used for each question (keeps the outline valid on every page) */
  headingLevel?: 'h3' | 'h4';
  class?: string;
}
const { items, headingLevel = 'h3', class: className = '' } = Astro.props;
const H = headingLevel;
---
<div class={`faq-list divide-y divide-line border-y border-line ${className}`}>
  {items.map((item) => (
    <details class="group">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 [&::-webkit-details-marker]:hidden">
        <H class="faq-q">{item.q}</H>
        <span class="grid size-9 shrink-0 place-items-center rounded-full border border-line text-cocoa transition-colors group-open:rotate-180 group-open:border-rose/40 group-open:bg-cream group-open:text-rose group-hover:border-rose/40 group-hover:text-rose motion-safe:transition-[transform,color,border-color] motion-safe:duration-300">
          <Icon name="chevron-down" size={18} />
        </span>
      </summary>
      <div class="measure pb-5 pr-12 text-plum-soft [&_a]:font-semibold [&_a]:text-cocoa [&_a]:underline [&_a]:decoration-gold [&_a]:decoration-2" set:html={inlineMd(item.a)} />
    </details>
  ))}
</div>

<style>
  /* Questions in the brand's display serif, sized for Cormorant (it gets spindly below ~1.3rem). */
  .faq-q {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.25rem + 0.4vw, 1.55rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0;
  }
</style>

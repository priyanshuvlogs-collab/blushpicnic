# ─────────────────────────────────────────────────────────────────────────────
#  Settings for ./deploy.sh (uploading the site from your own computer).
#
#  1. Copy this file and name the copy  deploy.env  (same folder).
#  2. Fill in the values below. deploy.env is git-ignored, so it never leaves
#     your computer.
#  3. Run  ./deploy.sh --dry-run  to test the connection, then  ./deploy.sh
#
#  Format: KEY=value, one per line. If a value contains spaces or # put it in
#  'single quotes'. Nothing in this file is ever run as a command.
#  Any setting can also come from the environment, which wins over this file:
#     FTP_PASS='…' ./deploy.sh
#  Full guide: docs/deployment.md
# ─────────────────────────────────────────────────────────────────────────────

# How to connect:
#   ftps  = FTP with encryption (explicit TLS on port 21). Works on every Hostinger plan. Default.
#   sftp  = over SSH (port 65002 on Hostinger), once SSH is switched on in
#           hPanel → Advanced → SSH Access. Uses FTP_USER + password or SSH_KEY.
#   rsync = over SSH, fastest, compares file contents. Needs SSH_KEY.
# Plain, unencrypted FTP is not supported on purpose: it sends the password in the clear.
PROTOCOL=ftps

# hPanel → Files → FTP Accounts.
FTP_HOST=147.93.42.131
FTP_PORT=21
FTP_USER=u228675638

# The FTP password. Leave it empty and deploy.sh asks for it each time (recommended),
# or paste it here between single quotes. NEVER put it in deploy.env.example, a
# commit, a chat message or an email.
FTP_PASS=

# The website folder, relative to where FTP logs you in. On Hostinger FTP you land
# in the domain folder that CONTAINS public_html, so this is just public_html.
#   With PROTOCOL=sftp or rsync you land in your home folder instead, so use:
#   REMOTE_DIR=domains/blushpicnic.com/public_html
REMOTE_DIR=public_html

# Where --config puts blush-config.php (the booking form's private settings).
# Empty = the folder above REMOTE_DIR, i.e. next to public_html, never inside it.
CONFIG_REMOTE_DIR=

# Check the FTP server's encryption certificate (yes/no). Keep yes.
# With FTP_HOST set to an IP address the check fails, because certificates are
# issued to names, not numbers. Run  ./deploy.sh --show-cert  and either:
#   • set FTP_HOST to the name it shows, or
#   • pin that exact certificate with its fingerprint below.
# FTP_VERIFY_CERT=no turns the check off completely; avoid it (anyone on your
# network could then pretend to be the server and capture the password).
FTP_VERIFY_CERT=yes
FTP_CERT_FINGERPRINT=

# For PROTOCOL=sftp/rsync with a key: path to your SSH private key, e.g. ~/.ssh/id_ed25519
# (add the matching .pub key in hPanel → Advanced → SSH Access → SSH keys).
SSH_KEY=

# How many files to upload at once. Lower it (to 2) if uploads keep failing.
PARALLEL=4

# The live address, used for the checks after each deploy.
SITE_URL=https://blushpicnic.com

# Extra files or folders in public_html that --delete must never remove,
# separated by spaces, relative to public_html; folders end with a slash.
# (.well-known/, Google/Bing verification files and Hostinger's .user.ini are
# always kept.) Example:  KEEP_REMOTE='old-menu.pdf press/'
KEEP_REMOTE=

# Where backups of the live site are saved on this computer (git-ignored).
BACKUP_DIR=backups
